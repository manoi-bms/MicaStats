<Window
    x:Class="Kil0bitSystemMonitor.Ai.AskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:ai="clr-namespace:Kil0bitSystemMonitor.Ai"
    Title="Ask MicaStats"
    Width="640" Height="720" MinWidth="420" MinHeight="420"
    WindowStartupLocation="CenterScreen"
    Background="#0E0E13"
    Foreground="#EDEDF2"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="14"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <!--
      Ask MicaStats: a conversation about this PC, laid out as a chat. The window only renders
      what the assistant streams (text, the tools it used, suggestions). Providers, limits and
      tools live in Services/Ai; a suggestion runs only when its button is clicked, through
      SuggestedActionRunner, which checks the target again first. Each turn is an AskTurnView.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ai:ChatStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: avatar, title, the model in use, New chat. -->
        <Border Grid.Row="0" Background="#141419" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                MinHeight="56" Padding="16,8,10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource ChatAvatar}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                    <TextBlock Text="Ask MicaStats" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ModelText" FontSize="11.5" Foreground="#88EDEDF2"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="NewButton" Grid.Column="2" Style="{StaticResource ChatIconButton}"
                        Content="&#xE710;" ToolTip="New chat (clears this conversation)"
                        AutomationProperties.Name="New chat" VerticalAlignment="Center"
                        Click="OnNewConversation" />
            </Grid>
        </Border>

        <!-- The conversation, or the empty screen with starter questions. -->
        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnTranscriptScrollChanged">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="500" Margin="24">
                    <ContentControl Style="{StaticResource ChatAvatar}" Width="48" Height="48" FontSize="22"
                                    HorizontalAlignment="Center" />
                    <TextBlock Text="How can I help?" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock x:Name="EmptyText" Foreground="#88EDEDF2" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="13" LineHeight="19"
                               Text="Ask anything about this PC: why it was slow a minute ago, what is using the memory, whether the CPU runs too hot. A question in Thai is answered in Thai." />
                    <WrapPanel x:Name="PromptPanel" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
                <StackPanel x:Name="TranscriptPanel" VerticalAlignment="Top" MaxWidth="860" Margin="20,18,20,4" />
            </Grid>
        </ScrollViewer>

        <!-- Problems and notices: what failed, Settings, Retry, "suggestions do nothing...". -->
        <Grid x:Name="StatusRow" Grid.Row="2" MaxWidth="860" Margin="20,2,20,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#A0EDEDF2" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource ChatFlatButton}"
                    Foreground="#3FD2E4" Content="Open Settings &gt; AI" Click="OnOpenSettings"
                    Visibility="Collapsed" Margin="8,0,0,0" />
            <Button x:Name="RetryButton" Grid.Column="2" Style="{StaticResource ChatFlatButton}"
                    Foreground="#3FD2E4" Content="Retry" Click="OnRetry"
                    Visibility="Collapsed" Margin="4,0,0,0" />
        </Grid>

        <!-- Composer: the question box with Send (Stop while an answer streams). -->
        <Border Grid.Row="3" Background="#141419" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                Padding="16,12,16,8">
            <StackPanel MaxWidth="860">
                <Border x:Name="Composer" CornerRadius="20" Background="#1C1C24" BorderThickness="1"
                        Padding="16,0,5,0" MouseLeftButtonDown="OnComposerMouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#33FFFFFF" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#3FD2E4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuestionBox" Style="{StaticResource ChatComposerText}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnQuestionKeyDown"
                                 ui:ControlHelper.PlaceholderText="Ask about this PC&#x2026;"
                                 AutomationProperties.Name="Question" />
                        <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,5">
                            <Button x:Name="SendButton" Style="{StaticResource ChatRoundButton}"
                                    Background="#3FD2E4" Foreground="#0E0E13" Content="&#xE724;"
                                    ToolTip="Send (Enter)" AutomationProperties.Name="Send" Click="OnSend" />
                            <Button x:Name="StopButton" Style="{StaticResource ChatRoundButton}"
                                    Background="#33FFFFFF" Foreground="#EDEDF2" Content="&#xE71A;"
                                    ToolTip="Stop (Esc)" AutomationProperties.Name="Stop" Click="OnStop"
                                    IsEnabled="False" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="Enter to send &#x00B7; Shift+Enter for a new line" FontSize="11"
                           Foreground="#88EDEDF2" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
