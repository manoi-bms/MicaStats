<Window
    x:Class="Kil0bitSystemMonitor.CaptureEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Kil0bitSystemMonitor.Services.Localization"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:ctrl="clr-namespace:Kil0bitSystemMonitor.Controls"
    Title="{loc:Text 'MicaStats Capture'}"
    Width="1120" Height="780" MinWidth="900" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    Background="#0E0E13"
    Foreground="#E9EDEDF2"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display">

    <!--
      The annotation editor. Tool buttons are RadioButtons in one group, so "exactly one tool is
      active" is enforced by the control model rather than by hand-managed state.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="DataCyan" Color="#3FD2E4" />

        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CFEDEDF2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#12FFFFFF" CornerRadius="6" Padding="9,6"
                                BorderBrush="Transparent" BorderThickness="1"
                                ToolTip="{TemplateBinding Tag}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333FD2E4" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DataCyan}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CFEDEDF2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="6" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#473FD2E4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#06222A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#3FD2E4" CornerRadius="6" Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6BDFEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="11" Padding="2"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="15" Height="15" Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#77FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Tools -->
        <Border DockPanel.Dock="Top" Background="#F01A1A22" Padding="10,8">
            <WrapPanel Orientation="Horizontal">
                <!--
                  Select is the default tool: opening straight into a drawing tool means the
                  first stray click leaves a mark on the capture.
                -->
                <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE8B0;" Tag="{loc:Text 'Select — move, resize or delete a mark (V)'}"
                             IsChecked="True" Checked="OnToolChecked" />
                <Rectangle Width="1" Height="24" Fill="#26FFFFFF" Margin="5,0,8,0" />
                <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE9AC;" Tag="{loc:Text 'Arrow (A)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE739;" Tag="{loc:Text 'Rectangle (R)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xED66;" Tag="{loc:Text 'Ellipse (E)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolLine" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE738;" Tag="{loc:Text 'Line (L)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolPen" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE70F;" Tag="{loc:Text 'Pen (P)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolHighlight" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE7E6;" Tag="{loc:Text 'Highlighter (H)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolText" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE8D2;" Tag="{loc:Text 'Text (T)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolStep" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE9D5;" Tag="{loc:Text 'Numbered step (N)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolRedact" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xED1A;" Tag="{loc:Text 'Redact — hide sensitive content (B)'}" Checked="OnToolChecked" />
                <RadioButton x:Name="ToolCrop" Style="{StaticResource ToolButton}" GroupName="tool"
                             Content="&#xE7A8;" Tag="{loc:Text 'Crop (C)'}" Checked="OnToolChecked" />

                <Rectangle Width="1" Height="24" Fill="#26FFFFFF" Margin="8,0" />

                <TextBlock Style="{StaticResource BarLabel}" Text="{loc:Text 'COLOUR'}" Margin="0,0,6,0" />
                <RadioButton x:Name="ColorRed" Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#FF453A" Tag="#FF453A" IsChecked="True" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#FFD60A" Tag="#FFD60A" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#32D74B" Tag="#32D74B" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#3FD2E4" Tag="#3FD2E4" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#0A84FF" Tag="#0A84FF" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#FFFFFF" Tag="#FFFFFF" Checked="OnColourChecked" />
                <RadioButton Style="{StaticResource Swatch}" GroupName="colour"
                             Background="#101014" Tag="#101014" Checked="OnColourChecked" />

                <TextBlock Style="{StaticResource BarLabel}" Text="{loc:Text 'SIZE'}" />
                <Slider x:Name="ThicknessSlider" Width="92" Minimum="1" Maximum="14" Value="3"
                        VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnThicknessChanged" />

                <TextBlock Style="{StaticResource BarLabel}" Text="{loc:Text 'HIDE'}" />
                <ComboBox x:Name="RedactStyleBox" Width="94" VerticalAlignment="Center"
                          SelectedIndex="0" SelectionChanged="OnRedactStyleChanged">
                    <ComboBoxItem Content="{loc:Text 'Pixelate'}" />
                    <ComboBoxItem Content="{loc:Text 'Blur'}" />
                    <ComboBoxItem Content="{loc:Text 'Solid'}" />
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- Actions -->
        <Border DockPanel.Dock="Bottom" Background="#F01A1A22" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource ActionButton}" Click="OnUndo"
                            ToolTip="{loc:Text 'Undo (Ctrl+Z)'}">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ActionButton}" Click="OnRedo"
                            ToolTip="{loc:Text 'Redo (Ctrl+Y)'}">
                        <TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnClear" ToolTip="{loc:Text 'Remove all marks'}">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="ApplyCropButton" Style="{StaticResource ActionButton}" Click="OnApplyCrop"
                            ToolTip="{loc:Text 'Apply the pending crop (Enter)'}" Content="{loc:Text 'Apply crop'}" />
                    <Button Style="{StaticResource ActionButton}" Click="OnResetCrop"
                            ToolTip="{loc:Text 'Restore the full capture'}" Content="{loc:Text 'Reset crop'}" />

                    <!-- Zoom. The percent is screen pixels per image pixel, so 100% is the capture's real size. -->
                    <Rectangle Width="1" Height="20" Fill="#26FFFFFF" Margin="2,0,8,0" />
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ActionButton}" Click="OnZoomOut"
                            ToolTip="{loc:Text 'Zoom out (Ctrl+− or Ctrl+wheel)'}">
                        <TextBlock Text="&#xE71F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="ZoomActualButton" Style="{StaticResource ActionButton}" Click="OnZoomActual"
                            ToolTip="{loc:Text 'Actual size (Ctrl+0)'}">
                        <TextBlock x:Name="ZoomText" Text="100%" MinWidth="30" TextAlignment="Center" />
                    </Button>
                    <Button x:Name="ZoomInButton" Style="{StaticResource ActionButton}" Click="OnZoomIn"
                            ToolTip="{loc:Text 'Zoom in (Ctrl++ or Ctrl+wheel)'}">
                        <TextBlock Text="&#xE8A3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="ZoomFitButton" Style="{StaticResource ActionButton}" Click="OnZoomFit"
                            ToolTip="{loc:Text 'Fit to window'}" Content="{loc:Text 'Fit'}" />
                </StackPanel>

                <!-- Trimmed when the bar is narrow, so the tooltip always has the whole message. -->
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource BarLabel}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Click="OnPin" ToolTip="{loc:Text 'Pin on top of everything'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Text 'Pin'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnOpenFolder" ToolTip="{loc:Text 'Open the captures folder'}">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnSaveAs" Content="{loc:Text 'Save as…'}" />
                    <Button Style="{StaticResource ActionButton}" Click="OnSave" ToolTip="{loc:Text 'Save to the captures folder (Ctrl+S)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Text 'Save'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnCopy" ToolTip="{loc:Text 'Copy to clipboard (Ctrl+C)'}"
                            Content="{loc:Text 'Copy'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas -->
        <Grid Background="#08080C">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="16" PreviewMouseWheel="OnScrollerWheel">
                <ctrl:AnnotationCanvas x:Name="Canvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- In-place text entry, positioned over the canvas when the text tool is used. -->
            <Canvas x:Name="TextLayer" IsHitTestVisible="True">
                <TextBox x:Name="TextEntry" Visibility="Collapsed" MinWidth="160" FontSize="15"
                         Background="#F0141420" Foreground="White" BorderBrush="#3FD2E4" BorderThickness="1"
                         CaretBrush="White" Padding="5,3"
                         KeyDown="OnTextEntryKey" LostFocus="OnTextEntryLostFocus" />
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
