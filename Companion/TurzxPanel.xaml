<UserControl x:Class="Kil0bitSystemMonitor.Companion.TurzxPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:loc="clr-namespace:Kil0bitSystemMonitor.Services.Localization"
    xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
    MinWidth="340">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{loc:Text 'Turzx Display'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{loc:Text 'Drive a Turzx 3.5-inch IPS USB-C sub-screen (USB35INCHIPSV2) directly from MicaStats with real-time hardware telemetry.'}"
                   Opacity="0.68" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{loc:Text 'USB display connection'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Text 'Connect a Turzx 3.5-inch IPS V2 USB serial display (VID_1A86&amp;PID_5722). No external vendor software is required.'}"
                                   Opacity="0.65" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Toggled="OnSettingsToggled"
                                     AutomationProperties.Name="{loc:Text 'Enable Turzx USB display'}"/>
                </Grid>

                <TextBlock x:Name="ConnectionStatus" Text="{loc:Text 'Turzx display is off.'}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,14,0,4"/>
                <TextBlock x:Name="ConnectionDetail" Text="{loc:Text 'Turn on Turzx display support, scan for USB serial ports, and connect.'}"
                           Opacity="0.68" FontSize="12" TextWrapping="Wrap"/>

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ScanButton" Content="{loc:Text 'Scan USB ports'}" helpers:ButtonIcon.Glyph="&#xE721;"
                            Click="OnScan" Padding="12,7" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DeviceList" MinWidth="180" MaxWidth="320" Margin="0,0,8,8" SelectionChanged="OnDeviceSelectionChanged"
                              AutomationProperties.Name="{loc:Text 'Discovered Turzx USB displays'}"/>
                    <Button x:Name="ConnectButton" Content="{loc:Text 'Connect'}" helpers:ButtonIcon.Glyph="&#xE8CE;"
                            Click="OnConnect" Padding="12,7" Margin="0,0,8,8"/>
                    <Button x:Name="DisconnectButton" Content="{loc:Text 'Disconnect'}" helpers:ButtonIcon.Glyph="&#xE8CD;"
                            Click="OnDisconnect" Padding="12,7" Margin="0,0,8,8"/>
                    <Button x:Name="TestPatternButton" Content="{loc:Text 'Test pattern'}" helpers:ButtonIcon.Glyph="&#xE790;"
                            Click="OnTestPattern" Padding="12,7" Margin="0,0,0,8"/>
                </WrapPanel>

                <ui:ToggleSwitch x:Name="AutoConnectToggle" Header="{loc:Text 'Automatically connect to this display when MicaStats starts'}"
                                 Toggled="OnSettingsToggled" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="DisplayControlsCard" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{loc:Text 'Display layout and brightness'}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Text 'Choose screen orientation, telemetry view mode, and backlight level. Only changed regions are streamed over USB.'}"
                           Opacity="0.65" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12"/>

                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="{loc:Text 'Orientation'}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="OrientationBox" MinWidth="210" SelectionChanged="OnOrientationChanged"
                                  AutomationProperties.Name="{loc:Text 'Turzx screen orientation'}">
                            <ComboBoxItem Tag="Landscape" Content="{loc:Text 'Landscape (480 × 320)'}"/>
                            <ComboBoxItem Tag="Portrait" Content="{loc:Text 'Portrait (320 × 480)'}"/>
                            <ComboBoxItem Tag="ReverseLandscape" Content="{loc:Text 'Reverse landscape (480 × 320)'}"/>
                            <ComboBoxItem Tag="ReversePortrait" Content="{loc:Text 'Reverse portrait (320 × 480)'}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:Text 'Telemetry view'}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ViewModeBox" MinWidth="220" SelectionChanged="OnViewModeChanged"
                                  AutomationProperties.Name="{loc:Text 'Turzx telemetry view mode'}">
                            <ComboBoxItem Tag="Dashboard" Content="{loc:Text 'Cyber dashboard (CPU / GPU / RAM)'}"/>
                            <ComboBoxItem Tag="Thermal" Content="{loc:Text 'Thermal &amp; power focus'}"/>
                            <ComboBoxItem Tag="StorageNet" Content="{loc:Text 'Storage &amp; network throughput'}"/>
                            <ComboBoxItem Tag="Clock" Content="{loc:Text 'Clock &amp; system summary'}"/>
                            <ComboBoxItem Tag="Splash" Content="{loc:Text 'Cyberpunk splash &amp; HUD'}"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{loc:Text 'Backlight brightness'}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Text 'Hardware backlight intensity from 0% (dimmest) to 100% (brightest).'}" Opacity="0.65" FontSize="12"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="5" Width="180"
                                ValueChanged="OnBrightnessChanged" AutomationProperties.Name="{loc:Text 'Turzx backlight brightness'}"/>
                        <TextBlock x:Name="BrightnessText" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{loc:Text 'Live screen preview'}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Text 'Exact pixel preview of the RGB565 frame rendered for the Turzx display.'}"
                           Opacity="0.65" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12"/>
                <Border Background="#FF070B12" BorderBrush="#FF1D2C44" BorderThickness="1" CornerRadius="8" Padding="8" HorizontalAlignment="Left">
                    <Image x:Name="PreviewImage" MaxWidth="340" MaxHeight="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
