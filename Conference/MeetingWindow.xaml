<Window x:Class="Kil0bitSystemMonitor.Conference.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="clr-namespace:Kil0bitSystemMonitor.Ai"
        xmlns:local="clr-namespace:Kil0bitSystemMonitor.Conference"
        Title="Meeting Assistant — MicaStats" Width="1180" Height="820" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ask.Background}"
        Foreground="{DynamicResource Ask.Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ai:ChatStyles /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="MeetingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/></Style>
            <Style x:Key="PrimaryMeetingButton" TargetType="Button" BasedOn="{StaticResource MeetingButton}"><Setter Property="Background" Value="{DynamicResource Ask.SendBack}"/><Setter Property="Foreground" Value="{DynamicResource Ask.SendGlyph}"/><Setter Property="BorderBrush" Value="{DynamicResource Ask.SendBack}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
            <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Ask.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Ask.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Ask.Ink}"/></Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Ask.Muted}"/></Style>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ask.Ink}"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,5,12,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="11"/><Setter Property="Background" Value="{DynamicResource Ask.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ask.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Ask.Border}"/><Setter Property="SelectionBrush" Value="{DynamicResource Ask.Selection}"/></Style>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="Foreground" Value="{DynamicResource Ask.Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Ask.Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ask.Ink}"/><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Ask.Surface}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Ask.Border}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Ask.Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Ask.Chrome}" BorderBrush="{DynamicResource Ask.Divider}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Ask.PillBack}" Margin="0,0,11,0"><TextBlock Text="🎙" FontFamily="Segoe UI Emoji" Foreground="{DynamicResource Ask.Accent}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Meeting Assistant" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Listen · Understand · Respond" Foreground="{DynamicResource Ask.Muted}" FontSize="12"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource MeetingButton}" Content="⚙ Service settings" Click="OpenServiceSettings_Click" AutomationProperties.Name="Open meeting service settings"/><Button Style="{StaticResource MeetingButton}" Content="💾 Save Markdown…" Click="Save_Click" AutomationProperties.Name="Save meeting report as Markdown" Margin="0"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" x:Name="ReadinessBanner" Background="{DynamicResource Ask.NoteBack}" BorderBrush="{DynamicResource Ask.Amber}" BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ChatFlatButton}" Foreground="{DynamicResource Ask.Accent}" Content="Configure services" Click="OpenServiceSettings_Click" AutomationProperties.Name="Configure meeting services" Margin="16,0,0,0"/><TextBlock x:Name="ReadinessText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Ask.Chrome}" BorderBrush="{DynamicResource Ask.Divider}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel>
                <Expander x:Name="AudioSetup" Header="🎛 Audio setup" IsExpanded="False" AutomationProperties.Name="Audio setup">
                <Grid x:Name="CaptureChoices"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="MICROPHONE" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="MicrophoneChoice" DisplayMemberPath="Name" AutomationProperties.Name="Microphone"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="CONFERENCE OUTPUT" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="OutputChoice" DisplayMemberPath="Name" AutomationProperties.Name="Conference output device"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="TRANSCRIPTION" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="ServiceChoice" SelectionChanged="Service_Changed" AutomationProperties.Name="Transcription service"><ComboBoxItem Content="ASR2"/><ComboBoxItem Content="ASR1"/><ComboBoxItem Content="ASR2 + ASR1"/></ComboBox></StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource MeetingButton}" Content="Refresh devices" VerticalAlignment="Bottom" Click="RefreshDevices_Click" AutomationProperties.Name="Refresh audio devices" Margin="0"/>
                </Grid>
                </Expander>
                <TextBlock x:Name="DualAsrNotice" Visibility="Collapsed" Text="Both services receive the same audio. Uploads double; differing readings are shown for review." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Ask.Muted}" Margin="0,8,0,0"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,5,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock x:Name="MicrophoneLevel" DockPanel.Dock="Right" Text="— dBFS" Foreground="{DynamicResource Ask.Accent}" FontSize="11"/><TextBlock Text="🎤 Microphone" FontWeight="SemiBold" FontSize="13"/></DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedItem.Name, ElementName=MicrophoneChoice, TargetNullValue=Choose a microphone}" ToolTip="{Binding SelectedItem.Name, ElementName=MicrophoneChoice}" Foreground="{DynamicResource Ask.Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <local:MeetingWaveform Grid.Row="2" x:Name="MicrophoneWaveform" Foreground="{DynamicResource Ask.Accent}" Background="{DynamicResource Ask.Divider}" ClipBrush="{DynamicResource Ask.Amber}" AutomationProperties.Name="Microphone amplitude over the last three seconds" ToolTip="Digital peak amplitude over the last 3 seconds. This indicates sound, not speech recognition."/>
                            <DockPanel Grid.Row="3"><TextBlock DockPanel.Dock="Right" Text="3 seconds" Foreground="{DynamicResource Ask.Muted}" FontSize="10"/><TextBlock x:Name="MicrophoneAudioStatus" Text="Not listening" FontSize="11"/></DockPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,8" Margin="5,0,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock x:Name="OutputLevel" DockPanel.Dock="Right" Text="— dBFS" Foreground="{DynamicResource Ask.Accent}" FontSize="11"/><TextBlock Text="🔊 Conference output" FontWeight="SemiBold" FontSize="13"/></DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedItem.Name, ElementName=OutputChoice, TargetNullValue=Choose an output device}" ToolTip="{Binding SelectedItem.Name, ElementName=OutputChoice}" Foreground="{DynamicResource Ask.Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <local:MeetingWaveform Grid.Row="2" x:Name="OutputWaveform" Foreground="{DynamicResource Ask.Accent}" Background="{DynamicResource Ask.Divider}" ClipBrush="{DynamicResource Ask.Amber}" AutomationProperties.Name="Conference output amplitude over the last three seconds" ToolTip="Digital peak amplitude over the last 3 seconds. Includes all apps playing through this output device."/>
                            <DockPanel Grid.Row="3"><TextBlock DockPanel.Dock="Right" Text="3 seconds" Foreground="{DynamicResource Ask.Muted}" FontSize="10"/><TextBlock x:Name="OutputAudioStatus" Text="Not listening" FontSize="11"/></DockPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Style="{StaticResource PrimaryMeetingButton}" Content="▶ Start listening" AutomationProperties.Name="Start listening" Click="Start_Click"/><Button x:Name="StopButton" Style="{StaticResource MeetingButton}" Content="⏹ Stop session" AutomationProperties.Name="Stop session" Click="Stop_Click" IsEnabled="False"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready. Choose your devices, then start listening." FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ServiceText" FontSize="11.5" Foreground="{DynamicResource Ask.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="3" x:Name="MeetingTabs" Margin="20,10,20,0" Foreground="{DynamicResource Ask.Ink}" Background="Transparent" BorderThickness="0">
            <TabItem Header="📝 Transcript" AutomationProperties.Name="Transcript"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="2,0,0,8"><Button DockPanel.Dock="Right" Content="↓ Latest" Click="LatestTranscript_Click" Style="{StaticResource ChatFlatButton}" Foreground="{DynamicResource Ask.Accent}" Padding="10,2" Margin="12,0,0,0" AutomationProperties.Name="Jump to latest transcript"/><TextBlock Text="Live transcript" Style="{StaticResource SectionTitle}"/><TextBlock Text="4-second audio chunks + service time" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ask.Muted}" FontSize="11"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}"><Grid><local:MeetingTranscriptView x:Name="TranscriptText" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ask.Ink}" SelectionBrush="{DynamicResource Ask.Selection}" Padding="2" AutomationProperties.Name="Live transcript"/><StackPanel x:Name="TranscriptEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="💬 Your conversation, in view" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="TranscriptEmptyHint" Text="Choose your devices and start listening." Foreground="{DynamicResource Ask.Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid></Border></Grid></TabItem>
                        <TabItem Header="✨ Summary &amp; answers" AutomationProperties.Name="Summary and answers">
                <ScrollViewer x:Name="AnalysisScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,10,0,0" MinHeight="390">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel><TextBlock Text="Meeting insights" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="AI language" VerticalAlignment="Center" FontSize="12"/>
                                            <ComboBox x:Name="AiLanguageChoice" SelectedValuePath="Tag" SelectionChanged="AiLanguage_Changed" Width="170" Margin="10,0,0,0" AutomationProperties.Name="AI response language" ToolTip="Language for summaries and suggested answers. Changes refresh active analysis and leave the transcript unchanged."><ComboBoxItem Content="Follow transcript" Tag="auto"/><ComboBoxItem Content="Thai · ไทย" Tag="th"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="AnalysisStatus" Text="Analysis starts with the meeting." TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock x:Name="AiQuotaText" Text="0 / 100 today" Foreground="{DynamicResource Ask.Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.ToolTip><ToolTip><TextBlock x:Name="UsageText" MaxWidth="340" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip></TextBlock>
                                    <Button Content="⚙ AI settings" Click="OpenAiSettings_Click" Style="{StaticResource ChatFlatButton}" Foreground="{DynamicResource Ask.Accent}" Padding="4" Margin="0,3,0,0" AutomationProperties.Name="Open AI settings"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Summary and key points" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Meeting summary and key points"/>
                                        <TextBlock x:Name="SummaryEmpty" Text="Your summary appears after transcript analysis. Enable Assistant and choose a provider in AI settings." TextWrapping="Wrap" Foreground="{DynamicResource Ask.Muted}" FontSize="12" Margin="10" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Suggested answers" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox Grid.Row="1" x:Name="QuestionChoice" DisplayMemberPath="Question" SelectionChanged="Question_Changed" ToolTip="{Binding SelectedItem.Question, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Question" Margin="0,8,0,6"/>
                                    <Grid Grid.Row="2">
                                        <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Suggested answer"/>
                                        <TextBlock x:Name="AnswerEmpty" Text="Choose a detected question above, or ask your own below." TextWrapping="Wrap" Foreground="{DynamicResource Ask.Muted}" FontSize="12" Margin="10" IsHitTestVisible="False"/>
                                    </Grid>
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                        <WrapPanel><Button x:Name="CopyButton" Style="{StaticResource MeetingButton}" Content="📋 Copy answer" Click="CopyAnswer_Click" IsEnabled="False" FontSize="12" Padding="9,6" AutomationProperties.Name="Copy answer with supporting context"/><Button x:Name="UseForSpeechButton" Style="{StaticResource MeetingButton}" Content="🔊 Prepare speech" Click="UseForSpeech_Click" IsEnabled="False" FontSize="12" Padding="9,6" AutomationProperties.Name="Prepare selected answer for speech"/></WrapPanel>
                                        <TextBlock x:Name="AnswerActionStatus" Text="Ask a question below to prepare an answer." FontSize="11" Foreground="{DynamicResource Ask.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Ask about this meeting" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="QuestionText" MaxLength="4096" PreviewKeyDown="Question_KeyDown" ToolTip="Enter a question, then press Enter or Ask privately" AutomationProperties.Name="Private meeting question"/>
                                    <Button Grid.Column="1" x:Name="AskButton" Style="{StaticResource PrimaryMeetingButton}" Content="✨ Ask privately" AutomationProperties.Name="Ask privately" Click="Ask_Click" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="QuestionStatus" Foreground="{DynamicResource Ask.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
<TabItem Header="📚 References" AutomationProperties.Name="Reference notes"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,12,0,0" MinHeight="280"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Add a MicaPad note" Style="{StaticResource SectionTitle}"/><TextBlock Text="Only bounded excerpts from notes you select are shared with the configured AI provider. Credential references are filtered." TextWrapping="Wrap" Foreground="{DynamicResource Ask.Muted}" FontSize="12" Margin="0,5,0,14"/><ComboBox x:Name="AvailableNotes" DisplayMemberPath="Title" AutomationProperties.Name="Available MicaPad notes"/><WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource MeetingButton}" Content="Add reference" Click="AddReference_Click"/><Button Style="{StaticResource MeetingButton}" Content="Refresh notes" Click="RefreshNotes_Click"/></WrapPanel></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Selected references" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="NotesCountText" DockPanel.Dock="Right" Foreground="{DynamicResource Ask.Accent}" FontWeight="SemiBold" Text="0 selected"/></DockPanel><ListBox Grid.Row="1" x:Name="SelectedNotes" DisplayMemberPath="Title" Margin="0,10,0,10" AutomationProperties.Name="Selected reference notes"/><DockPanel Grid.Row="2"><Button DockPanel.Dock="Left" Style="{StaticResource MeetingButton}" Content="Remove reference" Click="RemoveReference_Click"/><TextBlock x:Name="NotesStatus" Text="No notes selected." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Ask.Muted}"/></DockPanel></Grid></Border></Grid></ScrollViewer></TabItem>
            <TabItem Header="🔊 Speech" AutomationProperties.Name="Speech" x:Name="SpeechTab"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,12,0,0" MinHeight="390"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid x:Name="SpeechChoices"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLAYBACK DEVICE" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="PlaybackChoice" DisplayMemberPath="Name" AutomationProperties.Name="Speech playback device"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="VOICE" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="VoiceChoice" DisplayMemberPath="DisplayName" AutomationProperties.Name="Speech voice"/></StackPanel><Button Grid.Column="2" x:Name="RefreshVoicesButton" Style="{StaticResource MeetingButton}" Content="Refresh voices" Click="RefreshVoices_Click" VerticalAlignment="Bottom" Margin="0"/></Grid></Border><StackPanel Grid.Row="1" Margin="2,0,0,8"><TextBlock Text="Speech text" Style="{StaticResource SectionTitle}"/><TextBlock Text="Type text or prepare a suggested answer. Only this text is sent to the configured speech service." Foreground="{DynamicResource Ask.Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}"><TextBox x:Name="SpeechText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SpeechText_Changed" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Text to speak"/></Border><Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SpeakButton" Style="{StaticResource PrimaryMeetingButton}" Content="🔊 Speak" AutomationProperties.Name="Speak" Click="Speak_Click"/><Button x:Name="StopSpeechButton" Style="{StaticResource MeetingButton}" Content="Stop speaking" Click="StopSpeech_Click" IsEnabled="False"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock x:Name="SpeechStatus" Text="Ready · maximum 4,096 characters" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Listening pauses during playback and resumes afterward. Speech during that gap is not transcribed." TextWrapping="Wrap" Foreground="{DynamicResource Ask.Muted}" FontSize="11.5" Margin="0,3,0,0"/></StackPanel></Grid></Border></Grid></ScrollViewer></TabItem>
        </TabControl>
        <Border Grid.Row="4" BorderBrush="{DynamicResource Ask.Divider}" BorderThickness="0,1,0,0" Padding="20,8" Margin="0,10,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="SessionStateText" Text="Stopped" Foreground="{DynamicResource Ask.Accent}" FontWeight="SemiBold" Margin="0,0,16,0" FontSize="11"/>
                <TextBlock FontSize="11" Margin="0,0,16,0"><Run Text="Segments  "/><Run x:Name="SegmentCountText" Text="0" FontWeight="SemiBold"/></TextBlock>
                <TextBlock FontSize="11" Margin="0,0,16,0"><Run Text="Latest  "/><Run x:Name="MeetingTimeText" Text="—" FontWeight="SemiBold"/></TextBlock>
                <TextBlock FontSize="11" Margin="0,0,16,0"><Run Text="References  "/><Run x:Name="ReferenceCountText" Text="0" FontWeight="SemiBold"/></TextBlock>
                <TextBlock x:Name="AutosaveText" Text="💾 Transcript autosave on · audio is not saved" FontSize="11" Foreground="{DynamicResource Ask.Muted}" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.Name="Transcript save status"/>
                <Button x:Name="SavedTranscriptsButton" Content="📂 Saved transcripts" Click="SavedTranscripts_Click" FontSize="11" Padding="6,2" AutomationProperties.Name="Open saved transcripts folder"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
