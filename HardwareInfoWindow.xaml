<Window
    x:Class="Kil0bitSystemMonitor.HardwareInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:hw="clr-namespace:Kil0bitSystemMonitor.Services.HardwareInfo"
    xmlns:hlp="clr-namespace:Kil0bitSystemMonitor.Helpers"
    Title="MicaStats Hardware"
    Width="580" Height="660" MinWidth="560" MinHeight="480"
    WindowStartupLocation="CenterScreen"
    Background="#0E0E13"
    Foreground="#E9EDEDF2"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!--
      The CPU-Z-style inspector: static spec tabs over a live clock strip. Unlike the stats
      panel this is a plain standalone window - no overlay ownership, normal taskbar presence -
      because it must survive the panel dismissing itself when focus moves here.

      Width carries the six tab headers on ONE row. Adding icons widened each tab by roughly the
      glyph plus its margin, which pushed the strip past the old 470 and made TabPanel wrap to a
      second row, visually reordering the tabs. 580 sits comfortably above the ~525 the strip
      measures, and MinWidth stays above it too so a resize cannot recreate the wrap.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="DataCyan" Color="#3FD2E4" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F01A1A22" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#6EE9EDF2" />
        </Style>

        <!--
          Icon styles. The glyphs are Segoe Fluent Icons (Windows 11's system icon font) with
          Segoe MDL2 Assets as the Windows 10 fallback; codepoints live in Helpers/UiGlyphs so
          a section keeps the same icon everywhere it appears.
        -->
        <Style x:Key="TabIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource DataCyan}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Group-box icon. Collapses itself when a group carries no glyph. -->
        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B23FD2E4" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StripIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpecLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DDEDEDF2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CFEDEDF2" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="5" Padding="9,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#473FD2E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal owned templates so the ModernWPF theme cannot inject light chrome. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                                    Padding="10,6,10,0">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="8,5,8,6" Margin="0,0,1,0"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <!--
                              A ContentPresenter rather than a TextBlock bound to Header: the tab's
                              ItemTemplate supplies an icon beside the name, which a plain text
                              binding would render as the type name instead. TextElement.Foreground
                              carries the selection colour down to the label, while the icon keeps
                              its own explicit accent colour.
                            -->
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DataCyan}" />
                                <Setter Property="Foreground" Value="#F2FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DDEDEDF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Live strip: the CPU-Z signature readout, updated once per second while open. -->
        <Border DockPanel.Dock="Top" Background="#F01A1A22" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LiveClockText" Text="—" FontSize="21" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Style="{StaticResource StripIcon}" Text="{x:Static hlp:UiGlyphs.Cpu}" />
                        <TextBlock Style="{StaticResource SubLabel}" Text="CORE SPEED" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="LiveMemText" Text="—" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource DataCyan}" HorizontalAlignment="Right"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                        <TextBlock Style="{StaticResource StripIcon}" Text="{x:Static hlp:UiGlyphs.Memory}" />
                        <TextBlock Style="{StaticResource SubLabel}" Text="MEMORY LOAD" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: gather status on the left, actions on the right. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource SubLabel}" VerticalAlignment="Center"
                           Text="Reading hardware…" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource QuickButton}" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="{x:Static hlp:UiGlyphs.Refresh}" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Click="OnOpenDataFolder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="{x:Static hlp:UiGlyphs.Folder}" />
                            <TextBlock Text="Data Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Click="OnSaveReport">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="{x:Static hlp:UiGlyphs.Report}" />
                            <TextBlock Text="Save Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Header content: the tab's own icon, then its name. -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type hw:HardwareTab}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIcon}" Text="{Binding Icon}" />
                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Small, Segoe UI Variable Text, Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type hw:HardwareTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type hw:SpecGroup}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="{Binding Icon}" />
                                                <TextBlock Style="{StaticResource CardHeader}" Text="{Binding Title}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type hw:SpecRow}">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="138" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource SpecLabel}"
                                                                       Text="{Binding Label}" Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="1" Style="{StaticResource SpecValue}"
                                                                       Text="{Binding Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
