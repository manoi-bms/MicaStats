<UserControl
    x:Class="Kil0bitSystemMonitor.Pad.AiPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Kil0bitSystemMonitor.Services.Localization"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor.Pad"
    xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
    xmlns:ai="clr-namespace:Kil0bitSystemMonitor.Ai"
    Background="{DynamicResource Pad.Chrome}" Foreground="{DynamicResource Pad.WindowText}">

    <!-- The AI pane (MicaPad AI spec 3.2, AI chat UI spec 3.2 and 3.3): what was asked, on what
         text and where that goes, what the request is doing, the result as it streams in, and
         what to do with it. It draws an AiPaneView and raises events; it knows nothing about the
         editor. Colors are the Pad.* brushes, as in History and Search notes; ApplyTheme also puts
         them, and the two diff tints, in the pane's own resources. -->

    <UserControl.Resources>
        <Style x:Key="AiPane.ReviewCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="16" Height="16" Margin="0,2,9,0" VerticalAlignment="Top"
                                        CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Pad.Muted}">
                                    <helpers:DecorativeIcon x:Name="Check" Text="&#xE73E;" Visibility="Collapsed"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                        Foreground="{DynamicResource Pad.Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pad.Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pad.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pad.Hover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A flat toggle in the pad's own colors, for Changes and Source: the ModernWpf one paints its checked state in the Windows accent. -->
        <ControlTemplate x:Key="AiPane.Toggle" TargetType="ToggleButton">
            <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Pad.TextSoft}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Pad.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Pad.Hover}" />
                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                    <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Pad.Accent}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="PaneFlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Pad.TextSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Pad.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8,6,8">
                <Button x:Name="CloseButton" Style="{StaticResource PaneFlatButton}"
                        DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10" Padding="8,6" ToolTip="{loc:Text 'Close (Ctrl+Shift+A)'}" Click="OnCloseClick" />
                <!-- Stop has this place to itself, shown or not: no button that edits the note ever appears where
                     Stop was, so a click on Stop that lands a moment after the reply ended changes nothing. -->
                <Button x:Name="StopButton" DockPanel.Dock="Right" Content="{loc:Text 'Stop'}" FontSize="12" Padding="10,4" Margin="8,0,6,0"
                        helpers:ButtonIcon.Glyph="&#xE71A;" Cursor="Hand"
                        VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{loc:Text 'Stop the request and keep what came'}"
                        Click="OnStopClick" />
                <helpers:DecorativeIcon x:Name="HeadingGlyph" DockPanel.Dock="Left" Text="&#xE99A;" Margin="0,0,7,0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                        Foreground="{DynamicResource Pad.Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- What it ran on, where that goes and to which model. The line wraps and is never cut short: the
                 destination must always be readable. Beside it one toggle at most: Changes for a rewrite, Source
                 for a result shown rendered. Each keeps its own height when the line takes two. -->
            <DockPanel DockPanel.Dock="Top" Margin="12,0,12,6">
                <ToggleButton x:Name="ChangesToggle" DockPanel.Dock="Right" Content="{loc:Text 'Changes'}" FontSize="11.5" Padding="8,2"
                              Margin="8,0,0,0" Visibility="Collapsed" Cursor="Hand" VerticalAlignment="Top"
                              ToolTip="{loc:Text 'Show what changed, line by line'}" Template="{StaticResource AiPane.Toggle}"
                              Checked="OnChangesToggled" Unchecked="OnChangesToggled" />
                <ToggleButton x:Name="SourceToggle" DockPanel.Dock="Right" Content="{loc:Text 'Source'}" FontSize="11.5" Padding="8,2"
                              Margin="8,0,0,0" Visibility="Collapsed" Cursor="Hand" VerticalAlignment="Top"
                              ToolTip="{loc:Text 'Show the text as it would be inserted'}" Template="{StaticResource AiPane.Toggle}"
                              Checked="OnSourceToggled" Unchecked="OnSourceToggled" />
                <TextBlock x:Name="SourceText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" />
            </DockPanel>

            <!-- What the request is doing while it runs. The dots move only while they are on screen. -->
            <DockPanel x:Name="ActivityRow" DockPanel.Dock="Top" Margin="12,0,12,6" Visibility="Collapsed">
                <ai:TypingDots x:Name="ActivityDots" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,1,3,0"
                               Fill="{DynamicResource Pad.Muted}" />
                <TextBlock x:Name="ActivityText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" />
            </DockPanel>

            <TextBox x:Name="InstructionBox" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="140"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource Pad.Background}" Foreground="{DynamicResource Pad.Text}"
                     BorderBrush="{DynamicResource Pad.Border}" CaretBrush="{DynamicResource Pad.Text}"
                     ui:ControlHelper.PlaceholderText="{loc:Text 'What should AI do with this text?'}"
                     ToolTip="{loc:Text 'Enter runs it; Shift+Enter adds a line'}"
                     PreviewKeyDown="OnInstructionKeyDown" />

            <StackPanel x:Name="ToolIdeas" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed">
                <TextBlock Text="{loc:Text 'Ask about tasks or prepare passwords for secure storage.'}" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{DynamicResource Pad.Muted}" Margin="0,0,0,5" />
                <WrapPanel>
                    <Button Content="{loc:Text 'Review tasks'}" Padding="8,4" Margin="0,0,6,4" FontSize="11.5"
                            helpers:ButtonIcon.Glyph="&#xE9D5;" Click="OnReviewTasksClick" />
                    <Button Content="{loc:Text 'Protect passwords'}" Padding="8,4" Margin="0,0,0,4" FontSize="11.5"
                            helpers:ButtonIcon.Glyph="&#xE72E;" Click="OnProtectPasswordsClick" />
                </WrapPanel>
            </StackPanel>

            <!-- Bottom up: the four actions on a result, the status line above them, and above that how long a
                 request that finished whole took. Stop is in the header. -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="12,0,6,6">
                <Button x:Name="ReplaceButton" Content="{loc:Text 'Replace selection'}" FontSize="12" Padding="10,4" Margin="0,0,6,6"
                        helpers:ButtonIcon.Glyph="&#xE8AB;"
                        Foreground="{DynamicResource Pad.Accent}"
                        ToolTip="{loc:Text 'Put the result in place of the selected text'}" Click="OnReplaceClick" />
                <Button x:Name="InsertButton" Content="{loc:Text 'Insert below'}" FontSize="12" Padding="10,4" Margin="0,0,6,6"
                        helpers:ButtonIcon.Glyph="&#xE710;"
                        ToolTip="{loc:Text 'Add the result as a new paragraph after the text'}" Click="OnInsertClick" />
                <Button x:Name="CopyButton" Content="{loc:Text 'Copy'}" FontSize="12" Padding="10,4" Margin="0,0,6,6"
                        helpers:ButtonIcon.Glyph="&#xE8C8;"
                        Click="OnCopyClick" />
                <Button x:Name="RetryButton" Content="{loc:Text 'Try again'}" FontSize="12" Padding="10,4" Margin="0,0,6,6"
                        helpers:ButtonIcon.Glyph="&#xE72C;"
                        Click="OnRetryClick" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,0,12,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource Pad.TextSoft}" FontSize="12" Visibility="Collapsed" />
            <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="12,0,12,6" TextWrapping="Wrap"
                       Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" Visibility="Collapsed" />

            <!-- The result, or the changes in its place: a page of the note's own background. -->
            <Border Margin="12,0,12,8" Background="{DynamicResource Pad.Background}"
                    BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer x:Name="ResultScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8">
                        <Border x:Name="ToolReviewPanel" Visibility="Collapsed" Padding="10" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource Pad.Chrome}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <helpers:DecorativeIcon Text="&#xE83D;" DockPanel.Dock="Left" Margin="0,0,7,0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                        Foreground="{DynamicResource Pad.Accent}" />
                                    <TextBlock Text="{loc:Text 'Review proposed changes'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock x:Name="ToolReviewHelp" Text="{loc:Text 'Nothing has changed yet. Choose the items to apply.'}" TextWrapping="Wrap"
                                           FontSize="11.5" Foreground="{DynamicResource Pad.Muted}" Margin="0,0,0,6" />
                                <TextBlock Text="{loc:Text 'Secret values stay on this PC. Detection can miss unlabelled secrets.'}" TextWrapping="Wrap"
                                           FontSize="11.5" Foreground="{DynamicResource Pad.Muted}" Margin="0,0,0,8" />
                                <ItemsControl x:Name="ToolReviewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,2,0,2"
                                                      Style="{StaticResource AiPane.ReviewCheckBox}"
                                                      HorizontalContentAlignment="Stretch"
                                                      Checked="OnToolSelectionChanged" Unchecked="OnToolSelectionChanged"
                                                      AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Detail}">
                                                <DockPanel>
                                                    <helpers:DecorativeIcon Text="{Binding Glyph}" DockPanel.Dock="Left" Margin="0,2,7,0"
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                        Foreground="{DynamicResource Pad.Accent}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{DynamicResource Pad.Text}" />
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{DynamicResource Pad.Muted}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ToolReviewStatus" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource Pad.TextSoft}" Margin="0,6,0,4" />
                                <Button x:Name="ToolApplyButton" Content="{loc:Text 'Apply selected'}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Padding="10,5" FontSize="12" helpers:ButtonIcon.Glyph="&#xE930;"
                                        ToolTip="{loc:Text 'Apply only the checked changes to the original note'}" Click="OnToolApplyClick" />
                            </StackPanel>
                        </Border>
                        <local:PadAnswerBox x:Name="ResultBox" />
                        <TextBlock x:Name="ChangesSummary" Margin="0,0,0,6" Visibility="Collapsed"
                                   Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" />
                        <ItemsControl x:Name="ChangesList" Visibility="Collapsed" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="2,1">
                                        <DockPanel>
                                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Width="14" Text="{Binding Glyph}"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                       Foreground="{DynamicResource Pad.Muted}" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="{DynamicResource Pad.Text}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AiPane.AddedTint}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Pad.DiffAdded}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AiPane.RemovedTint}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Pad.DiffRemoved}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
