<?xml version="1.0"?>
<!-- MicaPad's INI highlighting. Colors are names only: MicaPad paints them from its palette. -->
<SyntaxDefinition name="MicaPad INI" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" underline="false" />
  <Color name="Section" underline="false" />
  <Color name="KeyName" underline="false" />
  <Color name="String" underline="false" />
  <RuleSet ignoreCase="true">
    <Span color="Comment" begin="^\s*[;\#]" />
    <!-- An inline comment: " ;" or " #" after a value or a section, not a value that starts with # ("color = #FF0000"). -->
    <Span color="Comment" begin="(?&lt;=[^\s=:]\s+)[;\#]" />
    <Rule color="Section">^\s*\[[^\]\r\n]*\]</Rule>
    <Rule color="KeyName">^\s*[^=:\s;\#\[][^=:\r\n]*?(?=\s*[=:])</Rule>
    <Rule color="String">(?&lt;=[=:]\s*)\S(.*\S)?</Rule>
  </RuleSet>
</SyntaxDefinition>
