<?xml version="1.0"?>
<!-- MicaPad's Ruby highlighting. Colors are names only: MicaPad paints them from its palette. -->
<SyntaxDefinition name="MicaPad Ruby" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" underline="false" />
  <Color name="String" underline="false" />
  <Color name="Keywords" underline="false" />
  <Color name="Bool" underline="false" />
  <Color name="Null" underline="false" />
  <Color name="Number" underline="false" />
  <Color name="Type" underline="false" />
  <Color name="Variable" underline="false" />
  <RuleSet>
    <Span color="Comment" begin="^=begin\b" end="^=end\b" multiline="true" />
    <Span color="Comment" begin="\#" />
    <!-- Heredocs. A span cannot refer back to its opening tag, so each common tag has its own span, which only a line holding that tag closes. Any other upper-case tag falls back to the generic span after them, which any upper-case line closes. -->
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?EOF(?![\w-])['&quot;]?" end="^\s*EOF\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?EOT(?![\w-])['&quot;]?" end="^\s*EOT\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?END(?![\w-])['&quot;]?" end="^\s*END\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?EOL(?![\w-])['&quot;]?" end="^\s*EOL\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?EOM(?![\w-])['&quot;]?" end="^\s*EOM\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?EOS(?![\w-])['&quot;]?" end="^\s*EOS\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?HEREDOC(?![\w-])['&quot;]?" end="^\s*HEREDOC\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?SQL(?![\w-])['&quot;]?" end="^\s*SQL\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?JSON(?![\w-])['&quot;]?" end="^\s*JSON\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?YAML(?![\w-])['&quot;]?" end="^\s*YAML\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?XML(?![\w-])['&quot;]?" end="^\s*XML\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?HTML(?![\w-])['&quot;]?" end="^\s*HTML\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?TEXT(?![\w-])['&quot;]?" end="^\s*TEXT\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?TXT(?![\w-])['&quot;]?" end="^\s*TXT\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?MSG(?![\w-])['&quot;]?" end="^\s*MSG\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?MESSAGE(?![\w-])['&quot;]?" end="^\s*MESSAGE\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?USAGE(?![\w-])['&quot;]?" end="^\s*USAGE\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?HELP(?![\w-])['&quot;]?" end="^\s*HELP\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?DATA(?![\w-])['&quot;]?" end="^\s*DATA\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?BODY(?![\w-])['&quot;]?" end="^\s*BODY\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?SCRIPT(?![\w-])['&quot;]?" end="^\s*SCRIPT\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?CONFIG(?![\w-])['&quot;]?" end="^\s*CONFIG\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?CONF(?![\w-])['&quot;]?" end="^\s*CONF\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?SH(?![\w-])['&quot;]?" end="^\s*SH\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?BASH(?![\w-])['&quot;]?" end="^\s*BASH\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?PY(?![\w-])['&quot;]?" end="^\s*PY\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?PYTHON(?![\w-])['&quot;]?" end="^\s*PYTHON\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?MARKER(?![\w-])['&quot;]?" end="^\s*MARKER\s*$" multiline="true" />
    <Span color="String" begin="(?&lt;![&lt;\w])&lt;&lt;[-~]?['&quot;]?[A-Z_][A-Z0-9_]*(?![\w-])['&quot;]?" end="^\s*[A-Z_][A-Z0-9_]*\s*$" multiline="true" />
    <Span color="String" begin="&quot;" end="&quot;" multiline="true">
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'" multiline="true">
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="Variable">@@?[A-Za-z_]\w*|\$[A-Za-z_]\w*</Rule>
    <Rule color="Variable">(?&lt;![:\w]):[A-Za-z_]\w*[?!]?</Rule>
    <Keywords color="Keywords"><Word>alias</Word><Word>and</Word><Word>begin</Word><Word>BEGIN</Word><Word>break</Word><Word>case</Word><Word>class</Word><Word>def</Word><Word>defined</Word><Word>do</Word><Word>else</Word><Word>elsif</Word><Word>end</Word><Word>END</Word><Word>ensure</Word><Word>for</Word><Word>if</Word><Word>in</Word><Word>module</Word><Word>next</Word><Word>not</Word><Word>or</Word><Word>redo</Word><Word>rescue</Word><Word>retry</Word><Word>return</Word><Word>self</Word><Word>super</Word><Word>then</Word><Word>undef</Word><Word>unless</Word><Word>until</Word><Word>when</Word><Word>while</Word><Word>yield</Word><Word>raise</Word><Word>require</Word><Word>require_relative</Word><Word>include</Word><Word>extend</Word><Word>attr_accessor</Word><Word>attr_reader</Word><Word>attr_writer</Word><Word>puts</Word><Word>print</Word><Word>private</Word><Word>protected</Word><Word>public</Word><Word>lambda</Word><Word>proc</Word><Word>loop</Word></Keywords>
    <Keywords color="Bool"><Word>true</Word><Word>false</Word></Keywords>
    <Keywords color="Null"><Word>nil</Word></Keywords>
    <Keywords color="Type"><Word>String</Word><Word>Integer</Word><Word>Float</Word><Word>Array</Word><Word>Hash</Word><Word>Symbol</Word><Word>Object</Word><Word>Class</Word><Word>Module</Word><Word>Proc</Word><Word>Range</Word><Word>Regexp</Word><Word>Struct</Word><Word>Comparable</Word><Word>Enumerable</Word><Word>Kernel</Word><Word>NilClass</Word></Keywords>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
