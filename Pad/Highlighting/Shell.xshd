<?xml version="1.0"?>
<!-- MicaPad's Shell highlighting. Colors are names only: MicaPad paints them from its palette. -->
<SyntaxDefinition name="MicaPad Shell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" underline="false" />
  <Color name="String" underline="false" />
  <Color name="Keywords" underline="false" />
  <Color name="Variable" underline="false" />
  <Color name="Directive" underline="false" />
  <Color name="Number" underline="false" />
  <RuleSet>
    <Span color="Directive" begin="^\#!" />
    <Span color="Comment" begin="(?&lt;=^|[\s;|&amp;(])\#" />
    <Span color="String" begin="(?&lt;![&lt;\w])(?&lt;!\(\([^)\r\n]*)&lt;&lt;-?[ \t]*['&quot;]?[A-Z_][A-Z0-9_]*(?![\w-])['&quot;]?" end="^\s*[A-Z_][A-Z0-9_]*\s*$" multiline="true" />
    <Span color="String" begin="&quot;" end="&quot;" multiline="true">
      <RuleSet>
        <Span begin="\\" end="." />
        <Rule color="Variable">\$\{[^}\r\n]*\}|\$[#?!@*$0-9-]|\$\w+</Rule>
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'" multiline="true" />
    <Rule color="Variable">\$\{[^}\r\n]*\}|\$[#?!@*$0-9-]|\$\w+</Rule>
    <Keywords color="Keywords"><Word>if</Word><Word>then</Word><Word>else</Word><Word>elif</Word><Word>fi</Word><Word>for</Word><Word>while</Word><Word>until</Word><Word>do</Word><Word>done</Word><Word>case</Word><Word>esac</Word><Word>in</Word><Word>function</Word><Word>select</Word><Word>time</Word><Word>return</Word><Word>exit</Word><Word>break</Word><Word>continue</Word><Word>local</Word><Word>export</Word><Word>declare</Word><Word>readonly</Word><Word>unset</Word><Word>set</Word><Word>shift</Word><Word>source</Word><Word>alias</Word><Word>eval</Word><Word>exec</Word><Word>trap</Word><Word>echo</Word><Word>printf</Word><Word>read</Word><Word>cd</Word></Keywords>
    <Rule color="Number">(?&lt;![\w.-])\d+(?![\w.-])</Rule>
  </RuleSet>
</SyntaxDefinition>
