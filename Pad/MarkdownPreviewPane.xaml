<UserControl
    x:Class="Kil0bitSystemMonitor.Pad.MarkdownPreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Kil0bitSystemMonitor.Services.Localization"
    xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor.Pad"
    MinWidth="180"
    Background="{DynamicResource Pad.Chrome}"
    Foreground="{DynamicResource Pad.WindowText}"
    AutomationProperties.Name="{loc:Text 'Markdown preview'}">

    <Border BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="True">
            <WrapPanel DockPanel.Dock="Top" Margin="12,8,8,8">
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <helpers:DecorativeIcon Text="&#xE89A;" Margin="0,0,7,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource Pad.Accent}"
                                               VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Text 'Preview'}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="{loc:Text 'Live'}" Margin="22,2,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Pad.Muted}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center" Margin="0,3,0,0">
                    <Button x:Name="RefreshButton" Style="{DynamicResource FlatButton}" Content="{loc:Text 'Refresh'}" Margin="0,0,6,0" Padding="8,4"
                            FontSize="11.5" helpers:ButtonIcon.Glyph="&#xE72C;"
                            ToolTip="{loc:Text 'Refresh the Markdown preview'}"
                            AutomationProperties.Name="{loc:Text 'Refresh Markdown preview'}"
                            Click="OnRefreshClick" />
                    <Button x:Name="CloseButton" Style="{DynamicResource FlatButton}" Content="{loc:Text 'Close'}" Padding="8,4"
                            FontSize="11.5" helpers:ButtonIcon.Glyph="&#xE711;"
                            ToolTip="{loc:Text 'Close split preview (Ctrl+Shift+M)'}"
                            AutomationProperties.Name="{loc:Text 'Close Markdown preview'}"
                            Click="OnCloseClick" />
                </WrapPanel>
            </WrapPanel>

            <Border Margin="12,0,12,10" Background="{DynamicResource Pad.Background}"
                    BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <ScrollViewer x:Name="PreviewScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="{loc:Text 'Rendered Markdown preview'}">
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="LimitText" Margin="0,0,0,8" Padding="8,6"
                                       Background="{DynamicResource Pad.InfoBar}"
                                       Foreground="{DynamicResource Pad.TextSoft}" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CapabilityText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Pad.Muted}" FontSize="11.5"
                                       Text="{loc:Text 'Images, HTML and math are shown as readable text; Mermaid uses local diagram settings.'}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <local:PadAnswerBox x:Name="ResultBox" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="18" MaxWidth="280">
                        <helpers:DecorativeIcon Text="&#xE8A5;" HorizontalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="22" Foreground="{DynamicResource Pad.Muted}" />
                        <TextBlock Text="{loc:Text 'Nothing to preview yet'}" Margin="0,8,0,2" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Text 'Start writing Markdown on the left. The rendered preview updates after you pause.'}"
                                   FontSize="11.5" Foreground="{DynamicResource Pad.Muted}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
