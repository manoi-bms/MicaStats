<UserControl
    x:Class="Kil0bitSystemMonitor.Pad.OpenNotesPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor.Pad"
    xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
    Background="Transparent"
    Foreground="{DynamicResource Pad.WindowText}"
    FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <local:NoteTabBrushConverter x:Key="NoteTabBrush" />
        <Style x:Key="OpenNoteRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" Padding="10,7" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Pad.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Pad.Hover}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Pad.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Pad.Popup}"
            BorderBrush="{DynamicResource Pad.PopupBorder}"
            BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,9">
                <TextBlock x:Name="ResultCount" x:FieldModifier="internal" DockPanel.Dock="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" />
                <helpers:DecorativeIcon Text="&#xE8FD;" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource Pad.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                           />
                <TextBlock Text="Open notes" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Pad.WindowText}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <TextBox x:Name="SearchInput" x:FieldModifier="internal" Padding="9,6"
                         Background="{DynamicResource Pad.Background}" Foreground="{DynamicResource Pad.Text}"
                         BorderBrush="{DynamicResource Pad.Border}" CaretBrush="{DynamicResource Pad.Text}"
                         AutomationProperties.Name="Find an open note"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnPreviewKeyDown" />
                <TextBlock x:Name="SearchPlaceholder" Text="Find by title or file path"
                           IsHitTestVisible="False" Margin="11,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pad.Muted}" FontSize="12" />
            </Grid>

            <TextBlock x:Name="EmptyText" x:FieldModifier="internal" Grid.Row="2" Grid.RowSpan="2"
                       Text="No open notes match this search." TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,28"
                       Foreground="{DynamicResource Pad.Muted}" Visibility="Collapsed" />

            <ListBox x:Name="NotesList" x:FieldModifier="internal" Grid.Row="3" Margin="0,8,0,0"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource OpenNoteRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseLeftButtonUp="OnNotesClick" PreviewKeyDown="OnPreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7" Margin="0,6,8,0"
                                     VerticalAlignment="Top" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <MultiBinding Converter="{StaticResource NoteTabBrush}" ConverterParameter="Accent">
                                        <Binding Path="Note.TabColorHue" />
                                        <Binding Path="TabPalette" RelativeSource="{RelativeSource AncestorType=local:OpenNotesPicker}" />
                                    </MultiBinding>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" LineHeight="18" MaxHeight="36"
                                       Foreground="{DynamicResource Pad.Text}" />
                            <WrapPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                                <TextBlock Text="Current" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pad.Accent}" Margin="0,1,8,0"
                                           Visibility="{Binding CurrentVisibility}" />
                                <TextBlock Text="Unsaved" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pad.Accent}" Margin="0,1,0,0"
                                           Visibility="{Binding UnsavedVisibility}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Margin="0,2,0,0"
                                       FontSize="11.5" Foreground="{DynamicResource Pad.Muted}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Margin="2,9,2,0" Text="↑↓ choose   Enter open   Esc close"
                       FontSize="11" Foreground="{DynamicResource Pad.Muted}" />
        </Grid>
    </Border>
</UserControl>
