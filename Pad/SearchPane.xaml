<UserControl
    x:Class="Kil0bitSystemMonitor.Pad.SearchPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor.Pad"
    Width="300" Background="{DynamicResource Pad.Chrome}">

    <!-- Search notes (search spec 1): a query, how it ran, and the matching passages of every note.
         Ask (MicaPad AI spec 4) adds an answer drawn from those passages, above them.
         Colors are the MicaPad window's Pad.* brushes, so the pane follows its theme. -->

    <Border BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8,6,8">
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10" Padding="8,6" ToolTip="Close (Ctrl+Shift+F)" Click="OnCloseClick" />
                <TextBlock Text="Search notes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,0,12,4">
                <Button x:Name="AskButton" DockPanel.Dock="Right" Content="Ask" FontSize="12" Padding="10,4" Margin="6,0,0,0"
                        VerticalAlignment="Stretch" ToolTip="Answer from your notes (Ctrl+Enter)" Click="OnAskClick" />
                <TextBox x:Name="QueryBox"
                         Background="{DynamicResource Pad.Background}" Foreground="{DynamicResource Pad.Text}"
                         BorderBrush="{DynamicResource Pad.Border}" CaretBrush="{DynamicResource Pad.Text}"
                         TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
            </DockPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="12,0,12,6" TextWrapping="Wrap"
                       Foreground="{DynamicResource Pad.Muted}" FontSize="11.5" />

            <!-- The answer to a question, on a page of the note's own background. Collapsed until Ask is used;
                 a long answer scrolls inside it, so the passages it cites stay in view below. -->
            <Border x:Name="AnswerPanel" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed"
                    Background="{DynamicResource Pad.Background}"
                    BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="10,8">
                    <ScrollViewer x:Name="AnswerScroller" MaxHeight="240"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:PadAnswerBox x:Name="AnswerBox" />
                    </ScrollViewer>
                    <!-- How the answer ended when it did not end well: an error, "Stopped", "Cut short at the length limit". -->
                    <TextBlock x:Name="AnswerNote" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource Pad.TextSoft}" FontSize="12" />
                    <WrapPanel>
                        <Button x:Name="AnswerStop" Content="Stop" FontSize="12" Padding="10,4" Margin="0,6,6,0"
                                Visibility="Collapsed" Click="OnAnswerStopClick" />
                        <Button x:Name="AnswerCopy" Content="Copy" FontSize="12" Padding="10,4" Margin="0,6,6,0"
                                Visibility="Collapsed" ToolTip="Copy the answer" Click="OnAnswerCopyClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ListBox x:Name="Results" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseLeftButtonUp="OnResultsClick" PreviewKeyDown="OnResultsKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,4,4,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" Foreground="{DynamicResource Pad.Muted}" FontSize="11" Margin="8,0,0,0" />
                                <!-- While an answer is shown: the number the answer cites this passage by, [1] to [8]. -->
                                <Border x:Name="SourceBadge" DockPanel.Dock="Left" Margin="0,0,6,0" Padding="5,0" MinWidth="18"
                                        VerticalAlignment="Center" CornerRadius="4"
                                        Background="{DynamicResource Pad.Hover}"
                                        BorderBrush="{DynamicResource Pad.Border}" BorderThickness="1">
                                    <TextBlock x:Name="SourceNumber" Text="{Binding Source}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Pad.Accent}" />
                                </Border>
                                <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="Snippet" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Pad.TextSoft}" Margin="0,2,0,0"
                                       Loaded="OnSnippetLoaded" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                <Setter TargetName="SourceBadge" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
