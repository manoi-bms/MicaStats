<UserControl
    x:Class="Kil0bitSystemMonitor.Pad.VaultCard"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every vault question MicaPad asks, and a revealed value, in one card over the editor area.
         Colors are the MicaPad window's Pad.* brushes, so the card follows its theme.
         A PIN or a value lives only in the boxes below: never in a tooltip, an automation name or a log. -->

    <UserControl.Resources>
        <!-- The Confirm card's primary label, in the alert color; a template keeps Content a plain string. -->
        <DataTemplate x:Key="AlertLabel">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource Pad.AlertRed}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Tab cycles inside the card: leaving it would answer the question with Cancel. -->
    <Grid x:Name="Root" Visibility="Collapsed" KeyDown="OnCardKeyDown" MouseDown="OnCardMouseDown"
          KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="Backdrop" Background="{DynamicResource Pad.Background}" Opacity="0.6" />

        <Border x:Name="Card" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Pad.Popup}" BorderBrush="{DynamicResource Pad.PopupBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Pad.WindowText}" />
                <TextBlock x:Name="BodyText" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource Pad.Muted}" />

                <TextBlock x:Name="PinCaption" FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource Pad.Muted}" />
                <PasswordBox x:Name="PinBox" MaxLength="12"
                             AutomationProperties.LabeledBy="{Binding ElementName=PinCaption}" />
                <TextBlock x:Name="Pin2Caption" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource Pad.Muted}" />
                <PasswordBox x:Name="PinBox2" MaxLength="12"
                             AutomationProperties.LabeledBy="{Binding ElementName=Pin2Caption}" />
                <TextBlock x:Name="Pin3Caption" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource Pad.Muted}" />
                <PasswordBox x:Name="PinBox3" MaxLength="12"
                             AutomationProperties.LabeledBy="{Binding ElementName=Pin3Caption}" />

                <TextBlock x:Name="LabelCaption" FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource Pad.Muted}" />
                <TextBox x:Name="LabelBox" IsUndoEnabled="False"
                         AutomationProperties.LabeledBy="{Binding ElementName=LabelCaption}" />

                <TextBox x:Name="ValueBox" Margin="0,14,0,0" IsReadOnly="True" IsUndoEnabled="False"
                         FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />

                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource Pad.AlertRed}" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CopyButton" Content="Copy" MinWidth="80" Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="OnCopyClick" />
                    <Button x:Name="PrimaryButton" MinWidth="80" Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="OnPrimaryClick" />
                    <Button x:Name="SecondaryButton" MinWidth="80" Click="OnSecondaryClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
