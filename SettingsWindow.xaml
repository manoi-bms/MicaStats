                                <ui:FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Auto-close brackets and quotes'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Typing an opening bracket or quote adds its closing match. Type the closing character to step over it. Skips the middle of a word.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="PadAutoCloseToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE751;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Word wrap'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Wrap long lines to the window. Alt+Z switches it in MicaPad.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="PadWrapToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE8FD;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Line numbers'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Show line numbers beside the text.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="PadLineNumbersToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE8D2;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Font'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Font and size of the text. Ctrl+wheel zooms in MicaPad.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="PadFontBox" Width="160" Margin="0,0,8,0" LostFocus="OnPadFontChanged"/>
                                    <ComboBox x:Name="PadFontSizeBox" Width="80" SelectionChanged="OnPadFontSizeChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Keep history for'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Older versions are thinned out over time; closed notes go to the Recycle Bin after this long.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="PadHistoryBox" Width="120" VerticalAlignment="Center" SelectionChanged="OnPadHistoryChanged">
                                    <ComboBoxItem Tag="30 days" Content="{loc:Text '30 days'}"/>
                                    <ComboBoxItem Tag="90 days" Content="{loc:Text '90 days'}"/>
                                    <ComboBoxItem Tag="180 days" Content="{loc:Text '180 days'}"/>
                                    <ComboBoxItem Tag="1 year" Content="{loc:Text '1 year'}"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Text 'Search'}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,4"/>
                        <pad:SearchSettingsPanel x:Name="PadSearchPanel"/>

                        <TextBlock Text="{loc:Text 'AI'}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,4"/>
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE99A;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Use AI in MicaPad'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Improve, translate, summarize or explain selected text, and get answers from your notes in Search notes. Nothing is sent until you run an action.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="PadAiToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PadAiPrivacyText" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap" Margin="4,0,0,8"/>
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Let Ask MicaStats search your notes'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Ask MicaStats can look up passages and read notes to answer a question.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="AiNotesInAskToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AiNotesInAskText" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap" Margin="4,0,0,8"/>
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Let MCP clients search your notes'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Programs such as Claude Code, connected through MCP, get two read-only tools: search_notes and get_note.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="AiNotesInMcpToggle" Toggled="OnPadToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AiNotesInMcpText" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap" Margin="4,0,0,8"/>
                        <Button x:Name="PadAiProviderButton" Content="{loc:Text 'AI provider settings…'}" helpers:ButtonIcon.Glyph="&#xE713;" Click="OnPadAiProviderSettings" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Meeting services -->
                    <StackPanel x:Name="MeetingSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'Meeting services'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Text 'Configure one ASR service for single-service transcription, or both for ASR2 + ASR1 comparison. Comparison sends the same audio to both services concurrently. Choose the mode in Meeting Assistant. Add TTS only for speech output.'}"
                                   Opacity="0.68" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <TextBlock Text="{loc:Text 'Test connection checks the address currently entered without saving it. ASR sends one second of generated silence; TTS sends a fixed test phrase and checks the audio without playing it. Tests run only when clicked and stop after 20 seconds.'}"
                                   Opacity="0.68" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#263B82F6" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <ui:FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Text 'ASR2 · Qwen speech recognition'}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{loc:Text 'Qwen profile · Single service or dual comparison · model Qwen/Qwen3-ASR-1.7B'}" Opacity="0.62" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <TextBlock Text="{loc:Text 'Base URL (includes /v1)'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="MeetingAsr2BaseUrlBox" MinWidth="460" Padding="10,7" ToolTip="{loc:Text 'Example: https://asr.example/v1'}"/>
                                    <TextBlock Text="{loc:Text 'Example: https://asr.example/v1'}" Opacity="0.48" FontSize="11.5" Margin="2,5,0,0"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="TestMeetingAsr2Button" Content="{loc:Text 'Test connection'}" helpers:ButtonIcon.Glyph="&#xE703;" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Top" AutomationProperties.Name="{loc:Text 'Test ASR2 connection'}"/>
                                        <TextBlock x:Name="MeetingAsr2TestStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" AutomationProperties.Name="{loc:Text 'ASR2 connection test result'}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#263B82F6" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <ui:FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Text 'ASR1 · Typhoon speech recognition'}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{loc:Text 'Typhoon profile · Alternative or comparison partner to ASR2 · model typhoon-asr-realtime'}" Opacity="0.62" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <TextBlock Text="{loc:Text 'Base URL (includes /v1)'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="MeetingAsr1BaseUrlBox" MinWidth="460" Padding="10,7" ToolTip="{loc:Text 'Example: https://asr.example/v1'}"/>
                                    <TextBlock Text="{loc:Text 'Example: https://asr.example/v1'}" Opacity="0.48" FontSize="11.5" Margin="2,5,0,0"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="TestMeetingAsr1Button" Content="{loc:Text 'Test connection'}" helpers:ButtonIcon.Glyph="&#xE703;" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Top" AutomationProperties.Name="{loc:Text 'Test ASR1 connection'}"/>
                                        <TextBlock x:Name="MeetingAsr1TestStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" AutomationProperties.Name="{loc:Text 'ASR1 connection test result'}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#263B82F6" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <ui:FontIcon Glyph="&#xE767;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Text 'VoxCPM speech output'}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{loc:Text 'Optional · Enable Speak with model voxcpm-thai'}" Opacity="0.62" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <TextBlock Text="{loc:Text 'Base URL (includes /v1)'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="MeetingTtsBaseUrlBox" MinWidth="460" Padding="10,7" ToolTip="{loc:Text 'Example: https://tts.example/v1'}"/>
                                    <TextBlock Text="{loc:Text 'Example: https://tts.example/v1'}" Opacity="0.48" FontSize="11.5" Margin="2,5,0,0"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="TestMeetingTtsButton" Content="{loc:Text 'Test connection'}" helpers:ButtonIcon.Glyph="&#xE703;" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Top" AutomationProperties.Name="{loc:Text 'Test TTS connection'}"/>
                                        <TextBlock x:Name="MeetingTtsTestStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" AutomationProperties.Name="{loc:Text 'TTS connection test result'}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,2,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{loc:Text 'Addresses are stored locally in config.json. Leave a service blank to keep it unavailable; the Meeting Assistant will show what still needs configuration before it starts or speaks.'}"
                                           Opacity="0.66" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="SaveMeetingServicesButton" Content="{loc:Text 'Save service settings'}" helpers:ButtonIcon.Glyph="&#xE74E;" Click="OnSaveMeetingServices" Style="{StaticResource AccentButtonStyle}" Padding="18,8" Margin="0,0,12,0"/>
                            <TextBlock x:Name="MeetingServicesStatus" Grid.Column="1" Text="{loc:Text 'Not configured'}" VerticalAlignment="Center" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                    <!-- StackChan companion -->
                    <StackPanel x:Name="StackChanSection" Visibility="Collapsed">
                        <companion:StackChanPanel x:Name="StackChanPanel"/>
                    </StackPanel>

                    <!-- Turzx USB Display -->
                    <StackPanel x:Name="TurzxSection" Visibility="Collapsed">
                        <companion:TurzxPanel x:Name="TurzxPanel"/>
                    </StackPanel>

                    <!-- AI -->
                    <StackPanel x:Name="AiSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'AI'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Text 'Ask MicaStats about this PC, and let Claude Desktop or Claude Code read its data. Everything here is off until you turn it on, and nothing is sent anywhere until you press Send, Explain or Test connection.'}" Opacity="0.6" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ai:AiSettingsPanel x:Name="AiPanel"/>
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel x:Name="DiagnosticsSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'Diagnostics'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Text 'Windows measures how long your boot took, which app delayed it, and how worn your battery is - and shows you almost none of it. These settings control what MicaStats records and when it speaks up.'}" Opacity="0.6" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE916;" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Record slowdowns'}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{loc:Text 'Keeps the last few minutes of per-process activity, so a stall can still be explained once it has passed. Task Manager only shows the present instant.'}" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="SlowdownRecordingToggle" Grid.Column="2" Toggled="OnDiagnosticsToggle" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Save a report automatically'}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{loc:Text 'Writes a timeline naming the process when a threshold is held long enough.'}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="SlowdownAutoCaptureToggle" Grid.Column="1" Toggled="OnDiagnosticsToggle" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'History kept'}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="SlowdownWindowText" Text="{loc:Text '5 minutes'}" Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Slider x:Name="SlowdownWindowSlider" Grid.Column="1" Width="200" Minimum="60" Maximum="900" TickFrequency="60" IsSnapToTickEnabled="True" ValueChanged="OnSlowdownWindowChanged" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{loc:Text 'Per-process CPU, memory and disk activity come from one kernel snapshot per sample, so recording costs a single system call. Per-process network traffic is deliberately absent: Windows only exposes it to an administrator.'}" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xEA8F;" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Tell me when something is wrong'}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{loc:Text 'A quiet notice in the corner when the processor runs hot, a drive fills up, or the battery wears out. Monitoring you have to watch is monitoring you miss.'}" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="AlertsToggle" Grid.Column="2" Toggled="OnDiagnosticsToggle" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="AlertRulesText" Text="" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE71C;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Watch for runaway searches'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'A coding tool that exits without cleaning up can leave a whole-drive file search running at full speed with nothing reading its output. MicaStats notices, and offers to end it. It never ends anything on its own.'}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="WatchOrphansToggle" Grid.Column="2" Toggled="OnDiagnosticsToggle" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE83F;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Battery in the taskbar'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="BatteryModuleText" Text="{loc:Text 'Shows charge beside the other modules. Portables only.'}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ShowBatteryToggle" Grid.Column="2" Toggled="OnDiagnosticsToggle" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="{loc:Text 'Open Diagnostics'}" helpers:ButtonIcon.Glyph="&#xE9D9;" Click="OnOpenDiagnosticsWindow" Padding="16,7" Margin="0,0,8,0"/>
                            <Button Content="{loc:Text 'Open data folder'}" helpers:ButtonIcon.Glyph="&#xE838;" Click="OnOpenDiagnosticsFolder" Padding="16,7"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="UpdatesSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'Updates'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Text 'MicaStats can check GitHub for new releases. Downloads are verified against the checksum published with each release before anything is installed.'}" Opacity="0.6" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE895;" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="UpdateHeadline" Text="MicaStats" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock x:Name="UpdateStatusText" Text="" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton" Grid.Column="2" Content="{loc:Text 'Check now'}" helpers:ButtonIcon.Glyph="&#xE895;" Click="OnCheckUpdates" Padding="16,7" VerticalAlignment="Center"/>
                                </Grid>

                                <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,16,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>

                                <WrapPanel x:Name="UpdateActionPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                    <Button x:Name="InstallUpdateButton" Content="{loc:Text 'Download and install'}" helpers:ButtonIcon.Glyph="&#xE896;" Click="OnInstallUpdate" Padding="16,7" Margin="0,0,8,0"/>
                                    <Button Content="{loc:Text 'Release notes'}" helpers:ButtonIcon.Glyph="&#xE8A5;" Click="OnOpenReleases" Padding="16,7" Margin="0,0,8,0"/>
                                    <Button x:Name="SkipUpdateButton" Content="{loc:Text 'Skip this version'}" helpers:ButtonIcon.Glyph="&#xE71A;" Click="OnSkipUpdate" Padding="16,7"/>
                                </WrapPanel>

                                <TextBlock Text="{loc:Text 'Installing requires administrator rights, so Windows will ask for permission. MicaStats closes and reopens itself as part of the upgrade.'}" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Check automatically'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{loc:Text 'Looks for a new release once a day, shortly after startup. Nothing is downloaded or installed without your say-so.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" x:Name="AutoUpdateToggle" Toggled="OnAutoUpdateToggled" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'About'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18"/>

                        <!-- The illustration is an offline application resource. Its quiet left side keeps
                             real product text readable while the glass layers remain visible on the right. -->
                        <Border x:Name="AboutHero"
                                MinHeight="230"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,24">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/MicaStats;component/Assets/about-banner.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                            </Border.Background>
                            <Grid>
                                <Border CornerRadius="13">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#F20B1118" Offset="0"/>
                                            <GradientStop Color="#D90B1118" Offset="0.42"/>
                                            <GradientStop Color="#3D0B1118" Offset="0.78"/>
                                            <GradientStop Color="#140B1118" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Margin="28,26" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                                    <Border Background="#2BFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE946;" FontSize="12" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding AppVersion}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="MicaStats" Foreground="White" FontSize="34" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:Text 'Your calm command center for system monitoring, focused notes, and private assistant tools.'}"
                                               Foreground="#E8F7FB" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Text 'Made for your daily flow'}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="AboutFeatureCards" Margin="0,0,0,24">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1F00B7C3" Margin="0,0,14,0">
                                        <ui:FontIcon Glyph="&#xE9D9;" FontSize="19" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Text 'See system health at a glance'}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{loc:Text 'Track the hardware signals that matter without turning your desktop into a dashboard.'}"
                                                   FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1F00B7C3" Margin="0,0,14,0">
                                        <ui:FontIcon Glyph="&#xE70B;" FontSize="19" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Text 'Turn notes into action'}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{loc:Text 'Use MicaPad for Markdown, tracked tasks, searchable notes, and a synchronized live preview.'}"
                                                   FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1F00B7C3" Margin="0,0,14,0">
                                        <ui:FontIcon Glyph="&#xE8BD;" FontSize="19" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Text 'Keep assistance within reach'}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{loc:Text 'Bring private assistant and meeting tools into the same focused Windows workspace.'}"
                                                   FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:FontIcon Glyph="&#xE71B;" FontSize="18" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Text 'Project and support'}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Text 'Explore the source, review releases, or tell us what would make MicaStats better.'}"
                                   FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="AboutProjectLinks" Margin="-4,0,0,18">
                            <ui:HyperlinkButton NavigateUri="https://github.com/manoi-bms/MicaStats" Margin="0,0,8,8" Padding="10,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE943;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Text 'GitHub repository'}"/>
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <ui:HyperlinkButton NavigateUri="https://github.com/manoi-bms/MicaStats/releases" Margin="0,0,8,8" Padding="10,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE896;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Text 'Releases'}"/>
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <ui:HyperlinkButton NavigateUri="https://github.com/manoi-bms/MicaStats/issues" Margin="0,0,8,8" Padding="10,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE90F;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Text 'Report an issue'}"/>
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <ui:HyperlinkButton NavigateUri="https://github.com/kil0bit-kb/kil0bit-system-monitor" Margin="0,0,8,8" Padding="10,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE8A7;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Text 'Original kil0bit project'}"/>
                                </StackPanel>
                            </ui:HyperlinkButton>
                        </WrapPanel>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,1,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Text 'Open source, shaped with care'}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{loc:Text 'Built by Chaiyaporn Suratemeekul (manoi-bms), with Claude Code. UX/UI inspired by iStat Menus for macOS. Based on kil0bit System Monitor by KB — kil0bit.'}"
                                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{loc:Text '© 2026 MicaStats · MIT License'}" FontSize="11.5" Opacity="0.6" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ui:NavigationView>

        <!-- Footer -->
        <Border Grid.Row="1" Padding="24,16" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="QuitBtn" Grid.Column="0" Content="{loc:Text 'Quit Application'}" helpers:ButtonIcon.Glyph="&#xE7E8;" Click="QuitButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Background="#D32F2F" Foreground="White" 
                        HorizontalAlignment="Left" Padding="16,8" ui:ControlHelper.CornerRadius="4"/>
                
                <Button x:Name="ResetAppBtn" Grid.Column="1" Click="ResetApp_Click" 
                        Foreground="#FF6666"
                        HorizontalAlignment="Center" Padding="16,8" ui:ControlHelper.CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Refresh" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Text 'Reset All Settings'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SaveCloseBtn" Grid.Column="2" Content="{loc:Text 'Save &amp; Close'}" helpers:ButtonIcon.Glyph="&#xE74E;" Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Padding="24,8" ui:ControlHelper.CornerRadius="4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
