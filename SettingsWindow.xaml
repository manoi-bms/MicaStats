<Window
    x:Class="Kil0bitSystemMonitor.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Kil0bitSystemMonitor.Services.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor"
    xmlns:ai="clr-namespace:Kil0bitSystemMonitor.Ai"
    xmlns:pad="clr-namespace:Kil0bitSystemMonitor.Pad"
    xmlns:companion="clr-namespace:Kil0bitSystemMonitor.Companion"
    xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
    mc:Ignorable="d"
    Title="{loc:Text 'MicaStats Settings'}"
    Height="720" Width="1000"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:ThemeManager.RequestedTheme="Dark">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Loaded="SettingsRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="SettingsNav" 
                        Grid.Row="0"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        SelectionChanged="SettingsNav_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Text 'Home'}" Tag="Home" IsSelected="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'General'}" Tag="General">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Setting" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Monitoring'}" Tag="Monitoring">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="FourBars" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Appearance'}" Tag="Appearance">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Edit" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Capture'}" Tag="Capture">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE722;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="MicaPad" Tag="MicaPad">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE70B;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Meeting'}" Tag="Meeting">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE720;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="StackChan" Tag="StackChan">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7F8;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Turzx Display'}" Tag="Turzx">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7F4;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'AI'}" Tag="AI">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8BD;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Diagnostics'}" Tag="Diagnostics">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE916;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'Updates'}" Tag="Updates">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE895;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Text 'About'}" Tag="About">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Help" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="24">
                    <!-- Home Section -->
                    <StackPanel x:Name="HomeSection" Visibility="Visible">
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock Text="{loc:Text 'Welcome'}" FontSize="42" FontWeight="Bold" Foreground="White" Margin="0,0,0,4">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.3" ShadowDepth="2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{loc:Text 'MicaStats is active and tracking your hardware performance with near-zero overhead.'}"
                                       FontSize="17" Opacity="0.7" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>

                        <UniformGrid Columns="2" HorizontalAlignment="Left">
                            <!-- General Card -->
                            <Button x:Name="HomeGeneralBtn" Click="HomeCard_Click" Tag="General" Width="280" Height="110" Margin="0,0,16,16" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Setting" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Text 'General'}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Text 'Startup behavior, updates, and core system settings.'}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Monitoring Card -->
                            <Button x:Name="HomeMonitoringBtn" Click="HomeCard_Click" Tag="Monitoring" Width="280" Height="110" Margin="0,0,0,16" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="FourBars" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Text 'Monitoring'}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Text 'Select CPU, GPU, and Network hardware sensors.'}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Appearance Card -->
                            <Button x:Name="HomeAppearanceBtn" Click="HomeCard_Click" Tag="Appearance" Width="280" Height="110" Margin="0,0,16,0" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Edit" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Text 'Appearance'}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Text 'Customize themes, colors, and font styles.'}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- About Card -->
                            <Button x:Name="HomeAboutBtn" Click="HomeCard_Click" Tag="About" Width="280" Height="110" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Help" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Text 'About'}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Text 'Version info, documentation, and support links.'}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </UniformGrid>

                        <!-- InfoBar Replacement -->
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="16" Margin="0,20,0,0" BorderBrush="{DynamicResource SystemAccentColorBrush}" BorderThickness="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Accept" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text 'Performance Note'}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{loc:Text 'Your system is being monitored using low-level Win32 APIs for maximum precision.'}" Opacity="0.8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- General Section -->
                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'General'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE774;" FontSize="22" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                             Margin="0,0,16,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Text 'App language'}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{loc:Text 'Choose the language for menus, settings, and dialogs.'}"
                                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{loc:Text 'Applies immediately. Notes and AI response language stay unchanged.'}"
                                               TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="AppLanguageCombo" Grid.Column="2" MinWidth="138" VerticalAlignment="Center"
                                          SelectionChanged="AppLanguage_SelectionChanged" AutomationProperties.Name="{loc:Text 'App language'}">
                                    <ComboBoxItem Content="ไทย" Tag="th"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Column 0 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE7B3;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Show Overlay'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Enable or disable the monitor.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.ShowOverlay, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE718;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Lock Position'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Prevent accidental dragging.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.LockPosition, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE72A;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Run at Startup'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Launch with Windows.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.LaunchOnStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Column 2 -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE740;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Hide in Fullscreen'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Hide during games/movies.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.HideOnFullscreen, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE90E;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Snap to Taskbar'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Dock to the taskbar area.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.StickToTaskbar, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE819;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Keep on Top'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Stay above other windows.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" IsOn="{Binding Config.AlwaysOnTop, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Row 3: Performance -->
                            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE916;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Text 'Refresh Rate'}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Text 'Set how often the monitor updates its metrics.'}" Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <ComboBox Grid.Column="2" SelectedValue="{Binding Config.UpdateInterval, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{loc:Text '500ms (High Performance)'}">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>500</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{loc:Text '1000ms (Default)'}">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>1000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{loc:Text '2000ms (Relaxed)'}">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>2000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{loc:Text '5000ms (Power Saver)'}">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>5000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Monitoring Section -->
                    <StackPanel x:Name="MonitoringSection" Visibility="Collapsed">
                        <TextBlock Text="{loc:Text 'Monitoring'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Telemetry Toggles -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Margin="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <TextBlock Text="{loc:Text 'Hardware Telemetry'}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16">
                                    <StackPanel>
                                        <!-- CPU / RAM Group -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <ui:FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Text 'Processor &amp; Memory'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'CPU Usage'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowCpu, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'RAM Usage'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowRam, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <ui:FontIcon Glyph="&#xE7AD;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Text 'Graphics &amp; Thermals'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'GPU Usage'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowGpu, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'GPU Temperature'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowTemp, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="{DynamicResource SystemControlElevationBorderBrush}" Margin="0,8,0,16" />

                                        <!-- Net / Disk Group -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <ui:FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Text 'Data &amp; Connectivity'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'Upload Speed'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowNetUp, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'Download Speed'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowNetDown, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <ui:FontIcon Glyph="&#xE7C1;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Text 'Storage Activity'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'Used Space %'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowDisk, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Text 'Real-time Activity'}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding Config.ShowDiskSpeed, Mode=TwoWay}" OnContent="" OffContent="" Margin="10,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Hardware Selection & Advanced -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text 'Hardware Selection'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                                        
                                        <TextBlock Text="{loc:Text 'Network Adapter'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="NetAdapterCombo" SelectedValue="{Binding Config.NetworkAdapter, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Tag="Default" Content="{loc:Text 'Default'}" />
                                        </ComboBox>

                                        <TextBlock Text="{loc:Text 'Graphics Card'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="GpuAdapterCombo" SelectedValue="{Binding Config.GpuAdapter, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Tag="Default" Content="{loc:Text 'Default'}" />
                                        </ComboBox>

                                        <TextBlock Text="{loc:Text 'Storage Drives'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DiskItems, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE793;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text 'Taskbar colours'}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="OverlayThemeHint" Text="" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="OverlayThemeCombo" Grid.Column="2" Width="150" VerticalAlignment="Center" SelectionChanged="OnOverlayThemeChanged">
                                    <ComboBoxItem Content="{loc:Text 'Match Windows'}" Tag="Auto"/>
                                    <ComboBoxItem Content="{loc:Text 'Always light'}" Tag="Light"/>
                                    <ComboBoxItem Content="{loc:Text 'Always dark'}" Tag="Dark"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Text 'Appearance'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Typography & Style -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text 'Typography'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="{loc:Text 'Font Family'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <ComboBox SelectedValue="{Binding Config.FontFamily, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Tag="Segoe UI" Content="{loc:Text 'Segoe UI'}" />
                                            <ComboBoxItem Tag="Segoe UI Variable Display" Content="{loc:Text 'Segoe UI Variable Display'}" />
                                            <ComboBoxItem Tag="Inter" Content="{loc:Text 'Inter'}" />
                                            <ComboBoxItem Tag="Roboto" Content="{loc:Text 'Roboto'}" />
                                            <ComboBoxItem Tag="Consolas" Content="{loc:Text 'Consolas'}" />
                                        </ComboBox>

                                        <TextBlock Text="{loc:Text 'Display Mode'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <ComboBox SelectedValue="{Binding Config.DisplayStyle, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Tag="Text" Content="{loc:Text 'Text'}" />
                                            <ComboBoxItem Tag="Compact" Content="{loc:Text 'Compact'}" />
                                        </ComboBox>

                                        <ui:ToggleSwitch Header="{loc:Text 'Bold Text'}" IsOn="{Binding Config.IsTextBold, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: Color Palette -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text 'Color Palette'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="{loc:Text 'Metric Accent'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,12" Click="ColorButton_Click" Tag="Accent">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.AccentColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'Select Accent'}" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="{loc:Text 'Label Tone'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,12" Click="ColorButton_Click" Tag="Label">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.LabelColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'Select Label'}" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="{loc:Text 'Capsule Color'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Click="ColorButton_Click" Tag="Pod">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.PodColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'Select Capsule'}" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 3: Scaling & Background -->
                            <StackPanel Grid.Column="4">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text 'Dashboard'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                                        <TextBlock Text="{loc:Text 'Scaling (Size)'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Config.ScaleFactor, Mode=TwoWay}" Margin="0,0,0,12"/>

                                         <TextBlock Text="{loc:Text 'Column Spacing'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider x:Name="ColumnSpacingSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.ColumnSpacing, Mode=TwoWay}" Margin="0,0,0,12"/>

                                        <ui:ToggleSwitch Header="{loc:Text 'iStat Taskbar (stacked)'}" IsOn="{Binding Config.StackedTaskbar, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <ui:ToggleSwitch Header="{loc:Text 'Live Graphs'}" IsOn="{Binding Config.ShowGraphs, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <ui:ToggleSwitch Header="{loc:Text 'Panel on Click'}" IsOn="{Binding Config.ShowPanelOnClick, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <ui:ToggleSwitch Header="{loc:Text 'Hover Panels'}" IsOn="{Binding Config.HoverPanels, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <ui:ToggleSwitch Header="{loc:Text 'Avoid Start Menu'}" IsOn="{Binding Config.AvoidStartMenu, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <ui:ToggleSwitch Header="{loc:Text 'Enable Capsules'}" IsOn="{Binding Config.ShowPods, Mode=TwoWay}" Margin="0,0,0,8" />
                                        
                                        <ui:ToggleSwitch Header="{loc:Text 'Background Plate'}" IsOn="{Binding Config.ShowBackground, Mode=TwoWay}" Margin="0,0,0,8" />
                                        
                                        <Button HorizontalAlignment="Stretch" Height="32" Click="ColorButton_Click" Tag="Background" 
                                                Visibility="{Binding Config.ShowBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.BackgroundColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'Select Plate Color'}" Margin="8,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Section Colors -->
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Text 'Section Colors'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Text 'Override label and metric colors per section. Leave unset to inherit global colors.'}" Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <UniformGrid Columns="4">

                                    <!-- Network -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Text 'Network'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="{loc:Text 'Label'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="NetLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.NetLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.NetLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.NetLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'UP / DN'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="NetLabel" Opacity="0.6" Margin="0,0,0,8" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                        <TextBlock Text="{loc:Text 'Metric'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="NetAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.NetAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.NetAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.NetAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'UP / DN'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="NetAccent" Opacity="0.6" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                    </StackPanel>

                                    <!-- CPU / RAM -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Text 'CPU / RAM'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="{loc:Text 'Label'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="CpuRamLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.CpuRamLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.CpuRamLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.CpuRamLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'CPU / RAM'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="CpuRamLabel" Opacity="0.6" Margin="0,0,0,8" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                        <TextBlock Text="{loc:Text 'Metric'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="CpuRamAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.CpuRamAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.CpuRamAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.CpuRamAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'CPU / RAM'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="CpuRamAccent" Opacity="0.6" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                    </StackPanel>

                                    <!-- GPU / Temp -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Text 'GPU / Temp'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="{loc:Text 'Label'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="GpuLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.GpuLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.GpuLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.GpuLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'GPU / TMP'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="GpuLabel" Opacity="0.6" Margin="0,0,0,8" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                        <TextBlock Text="{loc:Text 'Metric'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="GpuAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.GpuAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.GpuAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.GpuAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'GPU / TMP'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="GpuAccent" Opacity="0.6" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                    </StackPanel>

                                    <!-- Disk -->
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text 'Disk'}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="{loc:Text 'Label'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="DiskLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.DiskLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.DiskLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.DiskLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{loc:Text 'Disk'}" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="DiskLabel" Opacity="0.6" Margin="0,0,0,8" helpers:ButtonIcon.Glyph="&#xE72C;" Content="{loc:Text 'Clear'}"/>
                                        <TextBlock Text="{loc:Text 'Metric'}" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="DiskAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.DiskAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
