<Window
    x:Class="Kil0bitSystemMonitor.StatsPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:vm="clr-namespace:Kil0bitSystemMonitor.ViewModels"
    Title="Kil0bit System Monitor Stats"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="376"
    MaxHeight="820"
    ShowActivated="True"
    Background="Transparent"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <!--
      AllowsTransparency is deliberately NOT set. A per-pixel-alpha layered window can never be
      rounded by DWM, so opting out of layering is what buys real rounded corners and a system
      shadow (applied via DwmSetWindowAttribute in the code-behind).

      Topmost is deliberately NOT set either. This window is owned by the overlay's HWND, which
      makes it inherit WS_EX_TOPMOST and sort above its owner; setting Topmost as well would fight
      the overlay's 500ms z-order re-assert.
    -->

    <Border x:Name="Root"
            Background="#F21A1A1E"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,16,18,18">

                <!-- System identity -->
                <TextBlock Text="{Binding CpuName}" FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis" Foreground="#F0FFFFFF" />
                <TextBlock Text="{Binding GpuName}" FontSize="11.5" Opacity="0.62"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.5">
                    <TextBlock Text="{Binding TotalRamText}" FontSize="11" />
                    <TextBlock Text="  ·  " FontSize="11" />
                    <TextBlock Text="{Binding OsVersion}" FontSize="11" />
                    <TextBlock Text="  ·  " FontSize="11" />
                    <TextBlock Text="up " FontSize="11" />
                    <TextBlock Text="{Binding Uptime}" FontSize="11" />
                </StackPanel>

                <Separator Background="#1AFFFFFF" Margin="0,14,0,10" />

                <!-- Metric sections -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricSection}">
                            <StackPanel Margin="0,0,0,16">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               FontWeight="SemiBold" Opacity="0.85"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Primary}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Accent}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding Secondary}" FontSize="10.5"
                                           Opacity="0.5" Margin="0,1,0,6"
                                           TextTrimming="CharacterEllipsis" />

                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}"
                                             Height="3" Margin="0,0,0,6"
                                             Foreground="{Binding Accent}"
                                             Background="#1FFFFFFF"
                                             BorderThickness="0" />

                                <!-- History graph. Fixed size so the view model can project into
                                     known coordinates without measuring the visual tree. -->
                                <Grid Height="44" Width="320" HorizontalAlignment="Left"
                                      ClipToBounds="True">
                                    <Canvas ClipToBounds="True">
                                        <Polygon Points="{Binding Area}"
                                                 Fill="{Binding AreaFill}"
                                                 Stroke="{Binding Accent}"
                                                 StrokeThickness="1.4"
                                                 StrokeLineJoin="Round" />
                                    </Canvas>
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11" Opacity="0.42"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Per-logical-processor load -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCores}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Separator Background="#1AFFFFFF" Margin="0,0,0,10" />
                    <TextBlock Text="Logical processors" FontSize="12" FontWeight="SemiBold"
                               Opacity="0.85" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Cores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CoreLoad}">
                                <Grid Margin="0,0,10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="9.5"
                                               Opacity="0.45" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 Height="3" Foreground="#4FC3F7"
                                                 Background="#1FFFFFFF" BorderThickness="0"
                                                 VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Highest CPU consumers -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProcesses}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Separator Background="#1AFFFFFF" Margin="0,8,0,10" />
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Top processes" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
                        <TextBlock Text="share of total CPU" FontSize="9.5" Opacity="0.35"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                               Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkingSetText}"
                                               FontSize="10.5" Opacity="0.42" Margin="8,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#4FC3F7" MinWidth="42"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Esc or click away to close" FontSize="10" Opacity="0.3"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
