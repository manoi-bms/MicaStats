<Window
    x:Class="Kil0bitSystemMonitor.StatsPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:vm="clr-namespace:Kil0bitSystemMonitor.ViewModels"
    Title="Kil0bit System Monitor Stats"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="368"
    MaxHeight="860"
    ShowActivated="True"
    Background="Transparent"
    Foreground="#E9EDEDF2"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!--
      Foreground is set ON THE WINDOW deliberately: TextElement.Foreground inherits down the tree,
      and without it every plain TextBlock falls back to WPF's default black on this dark panel.
      RequestedTheme only swaps ModernWpf resource brushes; it does not touch plain TextBlocks.

      AllowsTransparency is deliberately NOT set (a per-pixel-alpha layered window can never be
      rounded by DWM). Topmost is deliberately NOT set (the window is owned by the overlay's HWND
      and inherits WS_EX_TOPMOST; setting it here would fight the overlay's z-order re-assert).
    -->

    <Window.Resources>
        <!-- Quarter-height gridlines behind every graph, the iStat signature. -->
        <DrawingBrush x:Key="GraphGrid" TileMode="Tile" Viewport="0,0,320,14"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,13.5" EndPoint="320,13.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#12FFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8AEDEDF2" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#66EDEDF2" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DDEDEDF2" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="#F5131316" BorderBrush="#2AFFFFFF"
            BorderThickness="1" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14,16,14">

                <!-- Identity header -->
                <TextBlock Text="{Binding CpuName}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#F2EDEDF2" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding TotalRamText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="   " />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding OsVersion}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="   up " />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Uptime}" />
                </StackPanel>

                <!-- Metric sections -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricSection}">
                            <StackPanel>
                                <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,12,0,10" />

                                <!-- Title row: name left, live value right -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="3" Height="10" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{Binding Accent}" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Primary}"
                                               FontSize="13.5" FontWeight="Bold"
                                               Foreground="{Binding Accent}" />
                                </Grid>

                                <!-- Gridded history graph -->
                                <Border Width="320" Height="56" HorizontalAlignment="Left"
                                        Background="{StaticResource GraphGrid}"
                                        BorderBrush="#1CFFFFFF" BorderThickness="0,0,0,1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Canvas ClipToBounds="True">
                                            <Polygon Points="{Binding Area}"
                                                     Fill="{Binding AreaFill}"
                                                     Stroke="{Binding Accent}"
                                                     StrokeThickness="1.2"
                                                     StrokeLineJoin="Round" />
                                        </Canvas>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                   Foreground="#55EDEDF2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Per-core strip, fused under the processor graph only -->
                                <ItemsControl ItemsSource="{Binding DataContext.Cores,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,5,0,0" HorizontalAlignment="Left">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCpu}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CoreLoad}">
                                            <!-- One thin bottom-anchored bar per logical processor -->
                                            <Border Width="9" Height="22" Margin="0,0,4,0"
                                                    Background="#17FFFFFF">
                                                <Rectangle Width="9" Fill="#4FC3F7"
                                                           Height="{Binding BarHeight}"
                                                           VerticalAlignment="Bottom" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Stat trio -->
                                <UniformGrid Columns="3" Margin="0,7,0,0" Width="320"
                                             HorizontalAlignment="Left">
                                    <UniformGrid.Resources>
                                        <DataTemplate DataType="{x:Type vm:StatPair}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource StatLabel}"
                                                           Text="{Binding Label}" />
                                                <TextBlock Style="{StaticResource StatValue}"
                                                           Text="{Binding Value}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </UniformGrid.Resources>
                                    <ContentPresenter Content="{Binding Stats[0]}" />
                                    <ContentPresenter Content="{Binding Stats[1]}" />
                                    <ContentPresenter Content="{Binding Stats[2]}" />
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Top processes -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProcesses}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,12,0,10" />
                    <Grid Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Top Processes" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="share of total CPU"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               Foreground="#CFEDEDF2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkingSetText}"
                                               FontSize="10" Foreground="#66EDEDF2"
                                               TextAlignment="Right" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#4FC3F7" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
