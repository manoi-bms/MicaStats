<Window
    x:Class="Kil0bitSystemMonitor.StatsPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:vm="clr-namespace:Kil0bitSystemMonitor.ViewModels"
    xmlns:ctrl="clr-namespace:Kil0bitSystemMonitor.Controls"
    xmlns:hlp="clr-namespace:Kil0bitSystemMonitor.Helpers"
    Title="MicaStats"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="372"
    MaxHeight="880"
    ShowActivated="True"
    Background="Transparent"
    Foreground="#E9EDEDF2"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ui:ThemeManager.RequestedTheme="Dark"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!--
      iStat Menus 7 dark layout: rounded cards on a near-black plate, a strict two-hue data
      palette (cyan primary, red counterpart), uppercase grey card headers with the live value
      at the right, discrete-bar history graphs, and ring gauges.

      Foreground is set ON THE WINDOW deliberately: TextElement.Foreground inherits down the
      tree, and without it every plain TextBlock falls back to WPF's default black.
      RequestedTheme only swaps ModernWpf resource brushes; it does not touch plain TextBlocks.

      AllowsTransparency is deliberately NOT set (a per-pixel-alpha layered window can never be
      rounded by DWM). Topmost is deliberately NOT set (the window is owned by the overlay's
      HWND and inherits WS_EX_TOPMOST; setting it here would fight the z-order re-assert).
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="DataCyan" Color="#3FD2E4" />
        <SolidColorBrush x:Key="DataRed" Color="#FF5147" />
        <SolidColorBrush x:Key="DimDot" Color="#55FFFFFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F01A1A22" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- Card title, e.g. "MEMORY". Uppercase is in the text itself; small caps look wrong at this size. -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8CE9EDF2" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI Variable Text, Segoe UI" />
        </Style>

        <!-- The live value on a card's title row. -->
        <Style x:Key="HeaderValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource DataCyan}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#6EE9EDF2" />
        </Style>

        <!--
          Card-header icon. Segoe Fluent Icons (Windows 11's system icon font) with Segoe MDL2
          Assets as the Windows 10 fallback; the codepoints live in Helpers/UiGlyphs so a section
          carries the same icon here, in the hardware inspector, and anywhere added later.

          Deliberately a dimmed accent rather than full cyan: the data values own the bright
          cyan, so an icon at full strength would compete with the reading it labels.
        -->
        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B23FD2E4" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Smaller variant for sub-headers inside a card (e.g. TOP MEMORY). -->
        <Style x:Key="SubIcon" TargetType="TextBlock" BasedOn="{StaticResource CardIcon}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <Style x:Key="ButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LegendValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DDEDEDF2" />
        </Style>

        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,5,0" />
        </Style>

        <!-- A big reading with its dotted label underneath (network Upload/Download). -->
        <Style x:Key="BigValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
        </Style>

        <!-- Footer quick-action pill, the iStat "open the system tool" buttons. -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CFEDEDF2" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="5" Padding="9,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#473FD2E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F70E0E13" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <!-- Identity card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowHeaderCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CardIcon}" FontSize="13"
                                       Text="{x:Static hlp:UiGlyphs.Machine}" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Style="{StaticResource SubLabel}" Text="{Binding TotalRamText}" />
                            <TextBlock Style="{StaticResource SubLabel}" Text="  ·  " />
                            <TextBlock Style="{StaticResource SubLabel}" Text="{Binding OsVersion}" />
                        </StackPanel>

                        <!-- Full CPU-Z-style inspector; the panel closes itself as focus moves there. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource QuickButton}" Click="OnOpenHardware">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="{x:Static hlp:UiGlyphs.Cpu}" />
                                    <TextBlock Text="Hardware" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickButton}" Click="OnOpenDiagnostics">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="{x:Static hlp:UiGlyphs.Stopwatch}" />
                                    <TextBlock Text="Diagnostics" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CPU card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCpuCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Cpu}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="CPU" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HeaderValue}" HorizontalAlignment="Right"
                                       Text="{Binding CpuHeaderText}" />
                        </Grid>

                        <ctrl:HistoryBarGraph Height="50" Mode="Stacked" Max="100"
                                              Series="{Binding CpuSeries}"
                                              SecondarySeries="{Binding CpuSystemSeries}"
                                              Tick="{Binding Tick}" />

                        <!-- ● User x%   ● System y% -->
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataCyan}" />
                            <TextBlock Style="{StaticResource SubLabel}" Text="{Binding CpuLegend1Label}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Style="{StaticResource LegendValue}" Text="{Binding CpuLegend1Value}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Ellipse VerticalAlignment="Center" Margin="0,1,5,0" Width="7" Height="7">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DimDot}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCpuSplit}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DataRed}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource SubLabel}" Text="{Binding CpuLegend2Label}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Style="{StaticResource LegendValue}" Text="{Binding CpuLegend2Value}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- One ring per logical processor -->
                        <ItemsControl ItemsSource="{Binding Cores}" Margin="0,9,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CoreLoad}">
                                    <ctrl:RingGauge Width="18" Height="18" RingThickness="2.5" AnimateChanges="False"
                                                    Margin="0,0,5,5"
                                                    Value="{Binding Percent}"
                                                    ToolTip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource SubLabel}" Text="UPTIME" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding UptimeText}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Task Manager" Tag="taskmgr" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Resource Monitor" Tag="resmon" Click="OnQuickAction" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memory card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMemoryCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Memory}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="MEMORY" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HeaderValue}" HorizontalAlignment="Right"
                                       Text="{Binding MemoryRingText}" />
                        </Grid>

                        <!-- The two iStat rings: physical memory and commit charge -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="68" Height="68" Margin="0,0,26,0">
                                <ctrl:RingGauge RingThickness="5" Value="{Binding MemoryPercent}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MemoryRingText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F2FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="MEMORY" FontSize="7.5" Foreground="#6EE9EDF2"
                                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Width="68" Height="68">
                                <ctrl:RingGauge RingThickness="5" Value="{Binding CommitPercent}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CommitRingText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F2FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="COMMIT" FontSize="7.5" Foreground="#6EE9EDF2"
                                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Breakdown rows: dot, label, value right -->
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataCyan}" />
                                <TextBlock Style="{StaticResource SubLabel}" Text="Used" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding MemUsedText}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DimDot}" />
                                <TextBlock Style="{StaticResource SubLabel}" Text="Free" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding MemFreeText}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataRed}" />
                                <TextBlock Style="{StaticResource SubLabel}" Text="Committed" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding MemCommitGbText}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DimDot}" />
                                <TextBlock Style="{StaticResource SubLabel}" Text="Cached" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding MemCachedText}" />
                        </Grid>

                        <!-- Memory pressure over time — the same history treatment the CPU card gets -->
                        <ctrl:HistoryBarGraph Height="40" Mode="Bars" Max="100" Margin="0,9,0,0"
                                              Series="{Binding RamSeries}"
                                              Tick="{Binding Tick}" />

                        <!-- Top memory consumers, the iStat memory-dropdown signature -->
                        <StackPanel Margin="0,9,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMemoryProcesses}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Style="{StaticResource SubIcon}" Text="{x:Static hlp:UiGlyphs.Memory}" />
                                <TextBlock Style="{StaticResource CardHeader}" Foreground="{StaticResource DataCyan}"
                                           Text="TOP MEMORY" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding MemoryTopProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                       Foreground="#CFEDEDF2" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,70,0" />
                                            <TextBlock Text="{Binding WorkingSetText}" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource DataCyan}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Task Manager" Tag="taskmgr" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Resource Monitor" Tag="resmon" Click="OnQuickAction" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                  Battery card. Collapses entirely on a desktop rather than rendering dashes:
                  ShowBatteryCard is false unless a pack was actually found.
                -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowBatteryCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Battery}" />
                            <TextBlock Style="{StaticResource CardHeader}" Text="BATTERY" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SubLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding BatteryStateText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BatteryValueText}" FontSize="30" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
                            <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SubLabel}" Text="{Binding BatteryRemainingText}" />
                                <TextBlock Style="{StaticResource SubLabel}" Text="{Binding BatteryPowerText}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Health}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SubLabel}" Text="HEALTH" />
                                <TextBlock Style="{StaticResource LegendValue}" Text="{Binding BatteryHealthText}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Power Settings"
                                    Tag="ms-settings:batterysaver" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Diagnostics"
                                    Click="OnOpenDiagnostics" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGpuCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Gpu}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="GPU" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HeaderValue}" HorizontalAlignment="Right"
                                       Text="{Binding GpuValueText}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SubLabel}" Text="{Binding GpuName}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Grid Width="44" Height="44" Margin="0,0,22,0">
                                <ctrl:RingGauge RingThickness="3.5" Value="{Binding GpuPercent}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding GpuValueText}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#F2FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="GPU" FontSize="6.5" Foreground="#6EE9EDF2"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid Width="44" Height="44">
                                <ctrl:RingGauge RingThickness="3.5" Value="{Binding GpuTempPercent}"
                                                ProgressBrush="{StaticResource DataRed}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding GpuTempText}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#F2FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="TMP" FontSize="6.5" Foreground="#6EE9EDF2"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,7">
                            <TextBlock Style="{StaticResource SubLabel}" Text="VRAM" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding GpuVramText}" />
                        </Grid>

                        <Grid>
                            <ctrl:HistoryBarGraph Height="40" Mode="Bars" Max="100"
                                                  Series="{Binding GpuSeries}"
                                                  Tick="{Binding Tick}" />
                            <TextBlock Text="This sensor could not be read on this system."
                                       FontSize="9.5" Foreground="#55EDEDF2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GpuGraphAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Task Manager" Tag="taskmgr" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Display Settings" Tag="ms-settings:display" Click="OnQuickAction" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Network card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNetworkCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Network}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="NETWORK" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BigValue}" Text="{Binding NetUpBigText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataRed}" />
                                    <TextBlock Style="{StaticResource SubLabel}" Text="Upload" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource BigValue}" Text="{Binding NetDownBigText}"
                                           HorizontalAlignment="Right" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataCyan}" />
                                    <TextBlock Style="{StaticResource SubLabel}" Text="Download" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Upload above the dashed axis, download below, one shared scale -->
                        <ctrl:HistoryBarGraph Height="50" Mode="Mirrored"
                                              Series="{Binding NetDownSeries}"
                                              SecondarySeries="{Binding NetUpSeries}"
                                              Max="{Binding NetGraphMax}"
                                              Tick="{Binding Tick}" />

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataRed}" />
                            <TextBlock Style="{StaticResource SubLabel}" Text="Peak ↑" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Style="{StaticResource LegendValue}" Text="{Binding NetPeakUpText}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DataCyan}" />
                            <TextBlock Style="{StaticResource SubLabel}" Text="Peak ↓" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Style="{StaticResource LegendValue}" Text="{Binding NetPeakDownText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Connection identity and session totals -->
                        <Grid Margin="0,9,0,0">
                            <TextBlock Style="{StaticResource SubLabel}" Text="ADAPTER" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding NetAdapterText}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource SubLabel}" Text="IP ADDRESS" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding NetIpText}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource SubLabel}" Text="SESSION" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource LegendValue}" HorizontalAlignment="Right"
                                       Text="{Binding NetTotalsText}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Network Settings" Tag="ms-settings:network" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Connections" Tag="ncpa.cpl" Click="OnQuickAction" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Disks card -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDisks}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowDisksCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Disk}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="DISKS" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HeaderValue}" HorizontalAlignment="Right"
                                       Text="{Binding DiskValueText}" />
                        </Grid>

                        <ctrl:HistoryBarGraph Height="38" Mode="Bars" Max="100"
                                              Series="{Binding DiskSeries}"
                                              Tick="{Binding Tick}" />

                        <ItemsControl ItemsSource="{Binding DiskRows}" Margin="0,7,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiskRow}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#CFEDEDF2" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SubLabel}"
                                                   Text="{Binding Detail}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Activity}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource DataCyan}"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource QuickButton}" Content="Disk Management" Tag="diskmgmt.msc" Click="OnQuickAction" />
                            <Button Style="{StaticResource QuickButton}" Content="Storage Settings" Tag="ms-settings:storagesense" Click="OnQuickAction" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Processes card -->
                <Border Margin="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProcesses}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowProcessesCard}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="{x:Static hlp:UiGlyphs.Processes}" />
                                <TextBlock Style="{StaticResource CardHeader}" Text="PROCESSES"
                                           Foreground="{StaticResource DataCyan}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubLabel}" Text="CPU"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   Foreground="#E0EDEDF2"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding WorkingSetText}"
                                                   FontSize="10" Foreground="#6EE9EDF2"
                                                   TextAlignment="Right" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DataCyan}" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
